# SHARED TOOLCHAIN HELPERS (not tied to a single language)
# =============================================================================

def get_compiler_version(cexe: str, default: str = 'unknown') -> str:
    """Extract a version identifier; per-compiler probing is declared via VersionSpec."""
    base = os.path.basename(cexe)
    spec = next((v for v in VERSION_SPECS if base.startswith(v.prefixes)), None)
    if spec is not None and spec.fixed is not None:
        return spec.fixed
    cmd = [cexe] + (spec.args if spec is not None and spec.args is not None else ['--version'])
    try:
        res = sp.run(cmd, stdout=sp.PIPE, stderr=sp.PIPE)
        out = (res.stdout or res.stderr).decode('utf-8', errors='ignore').strip()
        if spec is not None and spec.parse is not None:
            parsed = spec.parse(out, default)
            if parsed is not None:
                return parsed
        for part in out.split():
            clean = part.strip(',;:()')
            if clean and (clean[0].isdigit() or (clean.startswith('v') and len(clean) > 1 and clean[1].isdigit())):
                return clean.split('~')[0].split('ubuntu')[0]
    except Exception:
        pass
    return default


def resolve_compiler_path(args: argparse.Namespace, lang: str, cexe_name: str):
    try:
        if args.language_exes[lang] and cexe_name not in args.language_exes[lang]:
            return None
    except KeyError:
        pass
    cexe_path = which(cexe_name, path=args.path)
    return cexe_path


def find_compiler_versions(args: argparse.Namespace, lang: str, base_name: str):
    for v in VERSIONS:
        cexe = resolve_compiler_path(args, lang, f"{base_name}{v}")
        if cexe:
            yield cexe


def get_available_cpus() -> list[int]:
    if hasattr(os, 'sched_getaffinity'):
        try:
            cpus = sorted(list(os.sched_getaffinity(0)))
            if cpus:
                return cpus
        except Exception:
            pass
    count = os.cpu_count() or 1
    return list(range(count))


def out_directory(lang):
    return os.path.abspath(os.path.join(ROOT_PATH, f"proc_{os.getpid()}", lang.lower()))


def out_binary(lang):
    return lang_support(lang).out_binary


@cache
def get_gcc_lib_dir() -> str | None:
    for cc in ('gcc', 'cc', 'clang'):
        cc_path = which(cc)
        if cc_path:
            try:
                res = sp.run([cc_path, '-print-file-name=crtbegin.o'], stdout=sp.PIPE, stderr=sp.DEVNULL, text=True)
                out = res.stdout.strip()
                if out and out != 'crtbegin.o' and os.path.isfile(out):
                    return os.path.dirname(out)
            except Exception:
                pass
    matches = sorted(glob.glob('/usr/lib/gcc/*/*/crtbegin.o'))
    if matches:
        return os.path.dirname(matches[-1])
    return None


# GCC / Clang driver family, shared by C and C++ ---------------------------------

C_WARN_FLAGS = ['-Wall', '-Wextra']
CXX_WARN_FLAGS = ['-Wno-c++11-extensions']


def gcc_clang_op_flags(op, lang):
    if op == 'check':
        cexe_flags = ['-fsyntax-only']
        out_flag_and_exe = []
    elif op == 'compile':
        cexe_flags = ['-c']
        out_flag_and_exe = []
    elif op == 'build':
        cexe_flags = []
        out_flag_and_exe = ['-o', out_binary(lang)]
    else:
        return (None, None)
    return (cexe_flags, out_flag_and_exe)


def bm_C_and_Cxx_using_gcc(results: Results, lang, code_paths, args: argparse.Namespace, op, templated: bool):
    (cexe_flags, out_flag_and_exe) = gcc_clang_op_flags(op, lang)
    if cexe_flags is None:
        return None
    flags = (C_WARN_FLAGS if lang == 'C' else CXX_WARN_FLAGS) + cexe_flags
    base = 'gcc' if lang == 'C' else 'g++'
    for cexe in find_compiler_versions(args, lang, base):
        benchmark_compiler_op(code_paths, out_flag_and_exe, cexe, True, flags, args, op,
                              get_compiler_version(cexe), lang, templated, results)


def bm_C_and_Cxx_using_clang(results: Results, lang, code_paths, args: argparse.Namespace, op, templated: bool):
    (cexe_flags, out_flag_and_exe) = gcc_clang_op_flags(op, lang)
    if cexe_flags is None:
        return None
    warn = (C_WARN_FLAGS + ['-fno-color-diagnostics', '-fno-caret-diagnostics', '-fno-diagnostics-show-option']) if lang == 'C' else CXX_WARN_FLAGS
    base = 'clang' if lang == 'C' else 'clang++'
    for cexe in find_compiler_versions(args, lang, base):
        benchmark_compiler_op(code_paths, out_flag_and_exe, cexe, True, warn + cexe_flags, args, op,
                              get_compiler_version(cexe), lang, templated, results)


