def gcc_clang_op_flags(op, lang):
    if op == 'check':
        cexe_flags = ['-fsyntax-only']
        out_flag_and_exe = []
    elif op == 'compile':
        cexe_flags = ['-c']
        out_flag_and_exe = []
    elif op == 'build':
        cexe_flags = []
        out_flag_and_exe = ['-o', out_binary(lang)]
    else:
        return (None, None)
    return (cexe_flags, out_flag_and_exe)


def bm_C_and_Cxx_using_gcc(results: Results, lang, code_paths, args: argparse.Namespace, op, templated: bool):
    (cexe_flags, out_flag_and_exe) = gcc_clang_op_flags(op, lang)
    if cexe_flags is None:
        return None
    flags = (C_WARN_FLAGS if lang == 'C' else CXX_WARN_FLAGS) + cexe_flags
    base = 'gcc' if lang == 'C' else 'g++'
    for cexe in find_compiler_versions(args, lang, base):
        compile_file(code_paths, out_flag_and_exe, cexe, True, flags, args, op,
                     get_compiler_version(cexe), lang, templated, results)

def bm_C_and_Cxx_using_clang(results: Results, lang, code_paths, args: argparse.Namespace, op, templated: bool):
    (cexe_flags, out_flag_and_exe) = gcc_clang_op_flags(op, lang)
    if cexe_flags is None:
        return None
    warn = (C_WARN_FLAGS + ['-fno-color-diagnostics', '-fno-caret-diagnostics', '-fno-diagnostics-show-option']) if lang == 'C' else CXX_WARN_FLAGS
    base = 'clang' if lang == 'C' else 'clang++'
    for cexe in find_compiler_versions(args, lang, base):
        compile_file(code_paths, out_flag_and_exe, cexe, True, warn + cexe_flags, args, op,
                     get_compiler_version(cexe), lang, templated, results)

def bm_D(results: Results, code_paths, args: argparse.Namespace, op, templated: bool, use_dips: bool):
    lang = 'D'
    d_flags = []
    use_betterC = True
    if use_betterC:
        d_flags += ['-betterC']
    if use_dips:
        d_flags += ['-w', '-dip1008', '-dip1000']

    if op == 'check':
        cexe_flags = ['-o-']
    elif op == 'compile':
        cexe_flags = ['-c']
    elif op == 'build':
        if which('ld.lld') is not None:
            cexe_flags = ["-Xcc=-fuse-ld=lld"]
        elif which('ld.gold') is not None:
            cexe_flags = ["-Xcc=-fuse-ld=gold"]
        else:
            cexe_flags = []
    else:
        return None

    try:
        exes = args.language_exes[lang]
    except KeyError:
        return

    if not exes:
        exes = LANGUAGE_EXES[lang]

    for cexe in filter(lambda cexe: which(cexe), exes):
        if not cexe or not which(cexe):
            continue
        if cexe.startswith('dmd'):
            version = get_compiler_version(cexe)
            compile_file(code_paths=code_paths,
                         out_flag_and_exe=['-of=' + out_binary(lang)] if op == 'build' else [],
                         cexe=cexe,
                         runner=True,
                         cexe_flags=d_flags + cexe_flags,
                         args=args,
                         op=op,
                         compiler_version=version,
                         lang=lang,
                         templated=templated,
                         results=results)
        elif cexe.startswith('ldmd2'):
            version = get_compiler_version(cexe)
            compile_file(code_paths=code_paths,
                         out_flag_and_exe=['-of=' + out_binary(lang)] if op == 'build' else [],
                         cexe=cexe,
                         runner=True,
                         cexe_flags=d_flags + cexe_flags,
                         args=args,
                         op=op,
                         compiler_version=version,
                         lang=lang,
                         templated=templated,
                         results=results)
        elif cexe.startswith('gdc'):
            cexe_flags = ['-fsyntax-only'] if op == 'check' else []
            version = get_compiler_version(cexe)
            compile_file(code_paths=code_paths,
                         out_flag_and_exe=['-o' + out_binary(lang)] if op == 'build' else [],
                         cexe=cexe,
                         runner=True,
                         cexe_flags=cexe_flags,
                         args=args,
                         op=op,
                         compiler_version=version,
                         lang=lang,
                         templated=templated,
                         results=results)


