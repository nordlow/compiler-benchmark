    elif op == 'build':
        cexe_flags = ['build', '--dev']
        out_flag_and_exe = [f'--output={out_binary(lang)}']
    else:
        return None

    version = get_compiler_version(cexe)
    benchmark_compiler_op(
        code_paths,
        out_flag_and_exe=out_flag_and_exe,
        cexe=cexe,
        exec_cmd=(op == 'build'),
        cexe_flags=cexe_flags,
        args=args,
        op=op,
        compiler_version=version,
        lang=lang,
        templated=templated,
        results=results,
    )


def _roc_parse_version(out: str, default: str) -> str | None:
    parts = out.split()
    if 'commit' in parts:
        idx = parts.index('commit')
        if idx + 1 < len(parts):
            return parts[idx + 1].strip(',;:()')
    return parts[1] if len(parts) >= 2 else default


