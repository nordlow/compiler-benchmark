def _worker_init(cpu_list, idx_counter, lock, print_lock):
    with lock:
        idx = idx_counter.value
        idx_counter.value += 1
    cpu_id = cpu_list[idx % len(cpu_list)]
    if hasattr(os, 'sched_setaffinity'):
        try:
            os.sched_setaffinity(0, {cpu_id})
        except Exception:
            pass
    orig_print = builtins.print
    def _locked_print(*args, **kwargs):
        with print_lock:
            orig_print(*args, **kwargs)
            dest = kwargs.get('file') or sys.stdout
            if hasattr(dest, 'flush'):
                dest.flush()
    builtins.print = _locked_print


def _run_task(task):
    b_idx, r_idx, op, templated, task_args = task
    lang, runners, _, _ = LANGUAGE_BENCHMARKS[b_idx]
    runner = runners[r_idx]
    task_results, task_code_paths = {}, {}
    success = False
    task_args.has_stderr = False
    lang_dir = out_directory(lang)
    proc_dir = os.path.dirname(lang_dir)
    try:
        runner(task_results, task_code_paths, task_args, op, templated)
        if not getattr(task_args, 'has_stderr', False):
            success = True
    finally:
        if success:
            shutil.rmtree(lang_dir, ignore_errors=True)
            try:
                os.rmdir(proc_dir)
            except OSError:
                pass
    return task_results, os.getpid()


def _merge_results(target, incoming):
    for key, row in incoming.items():
        if key not in target:
            target[key] = list(row)
        else:
            for i, val in enumerate(row):
                if val is not None:
                    target[key][i] = val


def main():
    parser = argparse.ArgumentParser(formatter_class=argparse.ArgumentDefaultsHelpFormatter)

    parser.add_argument('--languages', '--langs', type=str,
                        default=None,
                        help='Languages (optionally combined with compilers) to benchmark separated by comma. For instance --languages=C:tcc,D:dmd,D:gdc,D:ldmd2.')

    parser.add_argument('--path', type=str,
                        default=None,
                        help='Path in which to look for compilers')

    parser.add_argument('--operations', '--ops', type=str,
                        default=','.join(SUPPORTED_OPERATIONS),
                        help='Operations to perform separated by comma')

    parser.add_argument('--function-count', '--fc', type=int,
                        default=200,
                        help='Number of functions generated and called')

    parser.add_argument('--function-depth', '--fd', type=int,
                        default=200,
                        help='Function call depth')

    parser.add_argument('--sample-rate', '--sr', type=int,
                        default=100,
                        help='Rate of memory usage sampling. Unit is samples per second.')

    parser.add_argument('--run-count', '--rc', type=int,
                        default=5,
                        help='Number of runs for each compilation')

    parser.add_argument('--values', '--val', type=str,
                        choices=['absolute', 'relative', 'both'],
                        default='absolute',
                        help='Whether to display absolute, relative, or both numeric values in the table.')

    parser.add_argument('--relative', '--rel', action='store_true',
                        help='Display relative numeric values (shortcut for --values=relative).')

    parser.add_argument('--highlight-min', '--hl', action='store_true',
                        help='Color- and bold-highlight the smallest (best) raw value in each column, '
                             'in whichever --values mode is selected (absolute, relative, or both).')

    args = parser.parse_args()
    if args.relative:
        args.values = ValuesMode.RELATIVE
    else:
        args.values = ValuesMode(args.values)
    install_missing_modules()

    lang_aliases: dict[Exec, Lang] = {
        Exec("hare"): Lang("Hare"),
        Exec("fortran"): Lang("Fortran"),
        Exec("gfortran"): Lang("Fortran"),
        Exec("haskell"): Lang("Haskell"),
        Exec("ghc"): Lang("Haskell"),
        Exec("pascal"): Lang("Pascal"),
        Exec("fpc"): Lang("Pascal"),
        Exec("scheme"): Lang("Scheme"),
        Exec("chez"): Lang("Scheme"),
        Exec("ocaml"): Lang("OCaml"),
        Exec("lua"): Lang("Lua"),
        Exec("luajit"): Lang("Lua"),
        Exec("typescript"): Lang("TypeScript"),
        Exec("ts"): Lang("TypeScript"),
        Exec("tsc"): Lang("TypeScript"),
        Exec("dart"): Lang("Dart"),
        Exec("common lisp"): Lang("Common Lisp"),
        Exec("commonlisp"): Lang("Common Lisp"),
        Exec("common-lisp"): Lang("Common Lisp"),
        Exec("lisp"): Lang("Common Lisp"),
        Exec("sbcl"): Lang("Common Lisp"),
        Exec("guile"): Lang("Guile"),
        Exec("guild"): Lang("Guile"),
    }

    def normalize_lang_spec(spec: str) -> str:
        name, sep, exes = spec.partition(":")
        canonical = lang_aliases.get(name.lower(), Lang(name.capitalize()))
        return f"{canonical}{sep}{exes}" if sep else canonical

    user_specified_languages = args.languages is not None
    raw_languages = args.languages if user_specified_languages else ','.join(LANG_EXES.keys())
    args.languages = [
        normalize_lang_spec(spec.strip())
        for spec in raw_languages.split(',')
        if spec.strip()
    ]
    args.language_exes = {}
    for language_exes_spec in args.languages:
        split = language_exes_spec.split(':')
        if len(split) == 2:
            language = split[0]
            exes = [e.strip() for e in split[1].split(',') if e.strip()]
        else:
            language = split[0]
            exes = []
        if language not in LANG_EXES:
            print('Warning: Ignoring unsupported language ' + language)
            continue

        candidate_exes = exes if exes else [str(e) for e in LANG_EXES[language]]
        found_exes = [
            exe for exe in candidate_exes
            if any(which(f"{exe}{v}", path=args.path) for v in VERSIONS)
        ]
        if not found_exes:
            if user_specified_languages:
                exe_str = candidate_exes[0] if len(candidate_exes) == 1 else f"any of {', '.join(candidate_exes)}"
                print(f"Warning: Ignoring unsupported language {language} ({exe_str} binary not found in PATH)")
            continue

        if user_specified_languages and exes:
            missing_exes = [exe for exe in exes if exe not in found_exes]
            for m in missing_exes:
                print(f"Warning: Compiler binary '{m}' for language {language} not found in PATH")

        actual_exes = found_exes if exes else []
        if language in args.language_exes:
            args.language_exes[language] += actual_exes
        else:
            args.language_exes[language] = actual_exes

    if not args.language_exes and not user_specified_languages:
        args.language_exes = LANG_EXES

    raw_ops = [x.strip().lower() for x in args.operations.split(",") if x.strip()]
    filtered_operations: list[Op] = []
    for op_str in raw_ops:
        try:
            filtered_operations.append(Op(op_str))
        except ValueError:
            print("Warning: Ignoring unsupported operation " + op_str)
    args.operations = filtered_operations

    results = {}

    print(markdown_header('Benchmark:', 1))

    # Compiler / runtime scaling & stability limits
    OCAML_JULIA_MAX_TOTAL_FUNCS = 10_000
    OCAML_JULIA_CAPPED_DIM = 200
    JAVA_MAX_TOTAL_FUNCS = 10_000
    JAVA_CAPPED_DIM = 100
    LUA_MAX_TOTAL_FUNCS = 20_000
    LUA_CAPPED_DIM = 150
    NIM_MAX_DEPTH = 50
    CUIK_MAX_DIM = 100

    tasks = []
    for op in args.operations:
        for b_idx, (lang, runners, ops, templated_variants) in enumerate(LANGUAGE_BENCHMARKS):
            if lang not in args.language_exes or op not in ops:
                continue

            task_args = copy.deepcopy(args)
            total_funcs = task_args.function_count * task_args.function_depth

            # These languages scale poorly on deeply nested functions with large synthetic function counts, an explicit limit is enforced:
            if lang in ('OCaml', 'Julia') and total_funcs >= OCAML_JULIA_MAX_TOTAL_FUNCS:
                task_args.function_count = OCAML_JULIA_CAPPED_DIM
                task_args.function_depth = OCAML_JULIA_CAPPED_DIM

            # Java class format limit: JVM constant pool cannot exceed 65535 entries per class
            if lang == 'Java' and total_funcs > JAVA_MAX_TOTAL_FUNCS:
                print(
                    f"Warning: Capping Java function count/depth from {task_args.function_count}x{task_args.function_depth} "
                    f"to {JAVA_CAPPED_DIM}x{JAVA_CAPPED_DIM} due to JVM constant pool limits"
                )
                task_args.function_count = JAVA_CAPPED_DIM
                task_args.function_depth = JAVA_CAPPED_DIM

            # LuaJIT limit: chunk constant table limit is 65536
            if lang == 'Lua' and total_funcs > LUA_MAX_TOTAL_FUNCS:
                print(
                    f"Warning: Capping Lua function count/depth from {task_args.function_count}x{task_args.function_depth} "
                    f"to {LUA_CAPPED_DIM}x{LUA_CAPPED_DIM} due to LuaJIT chunk constant limits"
                )
                task_args.function_count = LUA_CAPPED_DIM
                task_args.function_depth = LUA_CAPPED_DIM

            # Nim compiler has a hard limit of recursive generic instantiations:
            if lang == 'Nim' and task_args.function_depth > NIM_MAX_DEPTH:
                print(
                    f"Warning: Capping Nim function depth (--function-depth) from {task_args.function_depth} "
                    f"to {NIM_MAX_DEPTH} due to compiler generic recursion limit"
                )
                task_args.function_depth = NIM_MAX_DEPTH

            for templated in templated_variants:
                for r_idx, runner in enumerate(runners):
                    r_args = copy.deepcopy(task_args)
                    is_cuik = 'bm_C_using_cuik' in getattr(runner.__code__, 'co_names', ())
                    if is_cuik and resolve_compiler_path(r_args, 'C', 'cuik'):
                        if r_args.function_count > CUIK_MAX_DIM:
                            print(
                                f"Warning: Capping Cuik function count (--function-count) from {r_args.function_count} "
                                f"to {CUIK_MAX_DIM} due to compiler stability limit"
                            )
                            r_args.function_count = CUIK_MAX_DIM
                        if r_args.function_depth > CUIK_MAX_DIM:
                            print(
                                f"Warning: Capping Cuik function depth (--function-depth) from {r_args.function_depth} "
                                f"to {CUIK_MAX_DIM} due to compiler stability limit"
                            )
                            r_args.function_depth = CUIK_MAX_DIM
                    tasks.append((b_idx, r_idx, op, templated, r_args))

    cpus = get_available_cpus()
    cpu_use_count = len(cpus) - 2
    print(f"Running benchmarks in parallel across {cpu_use_count} CPU core(s) (1 worker per core)...")
    manager = mp.Manager()
    idx_counter = manager.Value('i', 0)
    lock = manager.Lock()
    print_lock = manager.Lock()

    root_existed_at_start = os.path.exists(ROOT_PATH)
    call_proc_dirs = {os.path.abspath(os.path.join(ROOT_PATH, f"proc_{MAIN_PID}"))}

    def cleanup_call_empty_dirs():
        if os.getpid() != MAIN_PID:
            return
        for proc_dir in sorted(call_proc_dirs, key=len, reverse=True):
            if os.path.isdir(proc_dir):
                for dirpath, _, _ in os.walk(proc_dir, topdown=False):
                    try:
                        os.rmdir(dirpath)
                    except OSError:
                        pass
        if not root_existed_at_start and os.path.isdir(ROOT_PATH):
            try:
                os.rmdir(ROOT_PATH)
            except OSError:
                pass

    atexit.register(cleanup_call_empty_dirs)

    orig_print = builtins.print
    def _locked_print(*args, **kwargs):
        with print_lock:
            orig_print(*args, **kwargs)
            dest = kwargs.get('file') or sys.stdout
            if hasattr(dest, 'flush'):
                dest.flush()
    builtins.print = _locked_print

    try:
        with mp.Pool(processes=cpu_use_count, initializer=_worker_init,
                     initargs=(cpus, idx_counter, lock, print_lock)) as pool:
            for p in getattr(pool, '_pool', []):
                if getattr(p, 'pid', None):
                    call_proc_dirs.add(os.path.abspath(os.path.join(ROOT_PATH, f"proc_{p.pid}")))
            for res, worker_pid in pool.imap_unordered(_run_task, tasks):
                call_proc_dirs.add(os.path.abspath(os.path.join(ROOT_PATH, f"proc_{worker_pid}")))
                if res:
                    _merge_results(results, res)
    finally:
        cleanup_call_empty_dirs()

    print()
    print(markdown_table(table_titles(args.values), results, values_mode=args.values, highlight=args.highlight_min))


