def build_compiler_cmd(lang: str, cexe: str, cexe_flags: list, out_flags: list, src_name: str, has_stdin: bool) -> list:
    """Construct the argv; a language may override the ordering via LangSupport.build_cmd."""
    if has_stdin:
        return [cexe] + cexe_flags + out_flags
    hook = lang_support(lang).build_cmd
    if hook is not None:
        return hook(cexe, cexe_flags, out_flags, src_name)
    return [cexe] + cexe_flags + out_flags + [src_name]


def measure_compilation(p_args: list, work_dir: str, sample_rate: int, stdin_text: str | None = None):
    """Execute compiler in work_dir and measure duration, RSS, and exit code."""
    from process_timer import ProcessTimer
    cwd = os.getcwd()
    os.chdir(work_dir)
    cstart = timer()
    outs, errs = b'', b''
    returncode = -1
    rss_mu = None

    try:
        if stdin_text is not None:
            import psutil
            comp_proc = sp.Popen(p_args, stdin=sp.PIPE, stdout=sp.PIPE, stderr=sp.PIPE)
            comp_proc.stdin.write(stdin_text.encode('utf-8'))
            comp_proc.stdin.close()
            try:
                p = psutil.Process(comp_proc.pid)
                max_rss = 0
                while comp_proc.poll() is None:
                    try:
                        rss = p.memory_info().rss
                        if rss > max_rss:
                            max_rss = rss
                    except (psutil.NoSuchProcess, psutil.AccessDenied):
                        break
                    time.sleep(1.0 / sample_rate)
                rss_mu = max_rss if max_rss > 0 else "missing"
            except Exception:
                rss_mu = "sampling error"
            outs, errs = comp_proc.communicate()
            returncode = comp_proc.returncode
        else:
            pt = ProcessTimer(args=p_args)
            try:
                while pt.poll():
                    time.sleep(1.0 / sample_rate)
            except Exception:
                rss_mu = "sampling error"
            finally:
                if rss_mu is None and getattr(pt, 'max_rss_mu', 0) != 0:
                    rss_mu = pt.max_rss_mu
                rss_mu = rss_mu or "missing"

            outs, errs = pt.comp_proc.communicate()
            returncode = pt.comp_proc.returncode
    finally:
        os.chdir(cwd)

    dur = timer() - cstart
    return dur, returncode, outs, errs, rss_mu


def run_compiled_file(args: list, run_count=1):
    durs = []
    for _ in range(0, run_count):
        cstart = timer()
        sp.run(args, stdout=sp.DEVNULL, stderr=sp.DEVNULL)
        durs.append(timer() - cstart)
    return min(durs) if durs else None


def run_target_binary(cexe: str, lang: str, lang_dir: str, exec_cmd, op: str, src_name: str, run_count: int):
    """Execute target binary or script, handling compiler-specific quirks."""
    if op == 'build' and exec_cmd:
        outb_path = os.path.join(lang_dir, out_binary(lang))
        if exec_cmd is True:
            if os.path.exists(outb_path) and not os.access(outb_path, os.X_OK):
                os.chmod(outb_path, os.stat(outb_path).st_mode | stat.S_IEXEC | stat.S_IXGRP | stat.S_IXOTH)
            return run_compiled_file(outb_path, run_count=run_count)
        if isinstance(exec_cmd, list):
            return run_compiled_file(exec_cmd + [outb_path], run_count=run_count)

    return None


def benchmark_compiler_op(code_paths: dict,
                          out_flag_and_exe: list,
                          cexe: str,
                          exec_cmd,
                          cexe_flags: list[str],
                          args: argparse.Namespace,
                          op: str,
                          compiler_version: str | None = None,
                          lang: str = None,
                          templated: bool = False,
                          results: dict = {},
                          stdin_input: str | None = None):
    spec = lang_support(lang)
    key = ResultKey(Lang(lang), templated, Exec(cexe))
    row = results.setdefault(key, [None] * RAW_ROW_LENGTH)
    row[LANG_IX] = lang
    row[TEMPLATED_IX] = 'Yes' if templated else 'No'
    row[CEXE_VERSION_IX] = compiler_version
    row[CEXE_PATH_IX] = os.path.basename(cexe)
    lang_dir = os.path.abspath(out_directory(lang))
    total_funcs = args.function_count * args.function_depth

    durs = []
    rss_mu = None
    worker_pid = os.getpid()
    tmpl_suffix = " (templated)" if templated else ""
    cname = os.path.basename(cexe)
    if _worker_active_tasks is not None:
        _worker_active_tasks[worker_pid] = (f"{lang}{tmpl_suffix} ({cname}) [{op}]", time.time())

    for run_ix in range(args.run_count):
        src_key = sourceIdOf(lang, templated, run_ix)
        if src_key in code_paths:
            src_path = code_paths[src_key]
        else:
            src_path = generate_test_program_file(lang, args, templated, run_ix,
                                                  program_dir=spec.program_dir,
                                                  source_filename=spec.source_filename,
                                                  order_sections=spec.order_sections)
            code_paths[src_key] = src_path
        src_name = os.path.relpath(src_path, lang_dir)

        p_args = build_compiler_cmd(lang, cexe, cexe_flags, out_flag_and_exe, src_name, has_stdin=bool(stdin_input))
        stdin_text = stdin_input.format(run_ix) if stdin_input else None

        dur, returncode, outs, errs, rss = measure_compilation(p_args, lang_dir, args.sample_rate, stdin_text)
        rss_mu = rss

        out_str = outs.decode('utf8', errors='ignore') if outs else ''
        err_str = errs.decode('utf8', errors='ignore') if errs else ''
        has_out = bool(out_str.strip())
        has_err = bool(err_str.strip())
        if has_err:
            setattr(args, 'has_stderr', True)

        if returncode != 0 and op != 'run':
            setattr(args, 'has_stderr', True)
            cmd_str = ' '.join(p_args)
            print(f"WARNING: Compilation `{cmd_str}` of source file `{src_name}` exited with return code {returncode}", file=sys.stderr)
            if has_out:
                print(f"  - stdout: {out_str.strip()}", file=sys.stderr)
            if has_err:
                print(f"  - stderr: {err_str.strip()}", file=sys.stderr)
            if rss_mu and isinstance(rss_mu, (int, float)):
                slot = CHECK_RSS_MU_IX if op == 'check' else (BUILD_RSS_MU_IX if op == 'build' else None)
                if slot:
                    row[slot] = rss_mu / total_funcs
            return None
        elif has_err:
            print(f"  - stderr: {err_str.strip()}", file=sys.stderr)

        durs.append(dur)

    dur_min = min(durs)
    if _worker_active_tasks is not None:
        _worker_active_tasks[worker_pid] = (f"{lang}{tmpl_suffix} ({cname}) [run]", time.time())
    run_dur_min = run_target_binary(cexe, lang, lang_dir, exec_cmd, op, src_name, args.run_count)
    if _worker_active_tasks is not None:
        _worker_active_tasks[worker_pid] = (f"{lang}{tmpl_suffix} ({cname}) [{op}]", time.time())

    output_size = None
    if op == 'build':
        outb_path = os.path.join(lang_dir, out_binary(lang))
        if is_machine_code_binary(outb_path, lang, cexe):
            try:
                output_size = os.path.getsize(outb_path)
            except OSError:
                output_size = None

    version_str = f' version {compiler_version}' if compiler_version is not None else ''
    cop = op.capitalize()
    if getattr(args, 'verbose', False):
        print(f'- {cop} took {dur_min:1.3f} seconds (using "{cexe}"{version_str})')

    row[LANG_IX] = lang
    row[TEMPLATED_IX] = 'Yes' if templated else 'No'
    row[CEXE_VERSION_IX] = compiler_version
    row[CEXE_PATH_IX] = os.path.basename(cexe)

    op_dur_col = {
        'ast-check': AST_CHECK_DUR_PER_FUNC_IX,
        'check': CHECK_DUR_PER_FUNC_IX,
        'compile': COMPILE_DUR_PER_FUNC_IX,
        'build': BUILD_DUR_PER_FUNC_IX,
        'run': RUN_DUR_PER_FUNC_IX,
    }.get(op)
    if op_dur_col is not None:
        row[op_dur_col] = dur_min / total_funcs

    if run_dur_min is not None:
        row[RUN_DUR_PER_FUNC_IX] = run_dur_min / total_funcs

    op_rss_col = {'check': CHECK_RSS_MU_IX, 'build': BUILD_RSS_MU_IX}.get(op)
    if op_rss_col is not None and rss_mu is not None:
        row[op_rss_col] = (rss_mu / total_funcs) if isinstance(rss_mu, (int, float)) else rss_mu

    if output_size is not None:
        row[OUTPUT_SIZE_IX] = output_size / total_funcs

    return row


# ---- parallel driver ------------------------------------------------------------

def _worker_init(cpu_list, idx_counter, lock, print_lock, active_tasks, status_len):
    global _worker_active_tasks, _worker_status_len
    _worker_active_tasks = active_tasks
    _worker_status_len = status_len
    with lock:
        idx = idx_counter.value
        idx_counter.value += 1
    cpu_id = cpu_list[idx % len(cpu_list)]
    if hasattr(os, 'sched_setaffinity'):
        try:
            os.sched_setaffinity(0, {cpu_id})
        except Exception:
            pass
    builtins.print = _make_locked_print(builtins.print, print_lock, status_len)


def _run_task(task):
    lang, r_idx, op, templated, task_args = task
    runner = LANGUAGES[lang].runners[r_idx]
    task_results, task_code_paths = {}, {}
    success = False
    task_args.has_stderr = False
    lang_dir = out_directory(lang)
    proc_dir = os.path.dirname(lang_dir)
    worker_pid = os.getpid()
    tmpl_suffix = " (templated)" if templated else ""
    if _worker_active_tasks is not None:
        _worker_active_tasks[worker_pid] = (f"{lang}{tmpl_suffix} [{op}]", time.time())
    try:
        runner(task_results, task_code_paths, task_args, op, templated)
        if not getattr(task_args, 'has_stderr', False):
            success = True
    finally:
        if _worker_active_tasks is not None:
            _worker_active_tasks.pop(worker_pid, None)
        if success:
            shutil.rmtree(lang_dir, ignore_errors=True)
            try:
                os.rmdir(proc_dir)
            except OSError:
                pass
    return task_results, os.getpid()


def _merge_results(target, incoming):
    for key, row in incoming.items():
        if key not in target:
            target[key] = list(row)
        else:
            for i, val in enumerate(row):
                if val is not None:
                    target[key][i] = val


def main():
    parser = argparse.ArgumentParser(formatter_class=argparse.ArgumentDefaultsHelpFormatter)

    parser.add_argument('--languages', '--langs', type=str,
                        default=None,
                        help='Languages (optionally combined with compilers) to benchmark separated by comma. For instance --languages=C:tcc,D:dmd,D:gdc,D:ldmd2.')

    parser.add_argument('--path', type=str,
                        default=None,
                        help='Path in which to look for compilers')

    parser.add_argument('--operations', '--ops', type=str,
                        default=','.join(SUPPORTED_OPERATIONS),
                        help='Operations to perform separated by comma')

    parser.add_argument('--function-count', '--fc', type=int,
                        default=200,
                        help='Number of functions generated and called')

    parser.add_argument('--function-depth', '--fd', type=int,
                        default=200,
                        help='Function call depth')

    parser.add_argument('--sample-rate', '--sr', type=int,
                        default=100,
                        help='Rate of memory usage sampling. Unit is samples per second.')

    parser.add_argument('--run-count', '--rc', type=int,
                        default=5,
                        help='Number of runs for each compilation')

    parser.add_argument('--values', '--val', type=str,
                        choices=['absolute', 'relative', 'both'],
                        default='absolute',
                        help='Whether to display absolute, relative, or both numeric values in the table.')

    parser.add_argument('--relative', '--rel', action='store_true',
                        help='Display relative numeric values (shortcut for --values=relative).')

    parser.add_argument('--highlight-min', '--hl', action='store_true',
                        help='Color- and bold-highlight the smallest (best) raw value in each column, '
                             'in whichever --values mode is selected (absolute, relative, or both).')

    parser.add_argument('--verbose', '-v', action='store_true',
                        help='Enable verbose progress logging.')

    args = parser.parse_args()
    if args.relative:
        args.values = ValuesMode.RELATIVE
    else:
        args.values = ValuesMode(args.values)
    install_missing_modules()

    lang_aliases = build_lang_aliases()

    def normalize_lang_spec(spec: str) -> str:
        name, sep, exes = spec.partition(":")
        canonical = lang_aliases.get(name.lower(), Lang(name.capitalize()))
        return f"{canonical}{sep}{exes}" if sep else canonical

    user_specified_languages = args.languages is not None
    raw_languages = args.languages if user_specified_languages else ','.join(LANGUAGES.keys())
    args.languages = [
        normalize_lang_spec(spec.strip())
        for spec in raw_languages.split(',')
        if spec.strip()
    ]
    args.language_exes = {}
    for language_exes_spec in args.languages:
        split = language_exes_spec.split(':')
        if len(split) == 2:
            language = split[0]
            exes = [e.strip() for e in split[1].split(',') if e.strip()]
        else:
            language = split[0]
            exes = []
        if language not in LANGUAGES:
            print('Warning: Ignoring unsupported language ' + language)
            continue

        candidate_exes = exes if exes else [str(e) for e in LANGUAGES[language].exes]
        found_exes = [
            exe for exe in candidate_exes
            if any(which(f"{exe}{v}", path=args.path) for v in VERSIONS)
        ]
        if not found_exes:
            if user_specified_languages:
                exe_str = candidate_exes[0] if len(candidate_exes) == 1 else f"any of {', '.join(candidate_exes)}"
                print(f"Warning: Ignoring unsupported language {language} ({exe_str} binary not found in PATH)")
            continue

        if user_specified_languages and exes:
            missing_exes = [exe for exe in exes if exe not in found_exes]
            for m in missing_exes:
                print(f"Warning: Compiler binary '{m}' for language {language} not found in PATH")

        actual_exes = found_exes if exes else []
        if language in args.language_exes:
            args.language_exes[language] += actual_exes
        else:
            args.language_exes[language] = actual_exes

    if not args.language_exes and not user_specified_languages:
        args.language_exes = {name: list(spec.exes) for name, spec in LANGUAGES.items()}

    raw_ops = [x.strip().lower() for x in args.operations.split(",") if x.strip()]
    filtered_operations: list[Op] = []
    for op_str in raw_ops:
        try:
            filtered_operations.append(Op(op_str))
        except ValueError:
            print("Warning: Ignoring unsupported operation " + op_str)
    args.operations = filtered_operations

    results = {}

    print(markdown_header('Benchmark:', 1))

    tasks = []
    for op in args.operations:
        for spec in LANGUAGES.values():
            if spec.name not in args.language_exes or op not in spec.ops:
                continue

            # Per-language scaling/stability limits live in the language's own block.
            task_args = copy.deepcopy(args)
            for warning in spec.limit_args(task_args):
                print(warning)

            for templated in spec.templated_variants:
                for r_idx in range(len(spec.runners)):
                    tasks.append((spec.name, r_idx, op, templated, copy.deepcopy(task_args)))

    cpus = get_available_cpus()
    cpu_use_count = len(cpus) - 2
    print(f"Running benchmarks in parallel across {cpu_use_count} CPU core(s) (1 worker per core)...")
    manager = mp.Manager()
    idx_counter = manager.Value('i', 0)
    lock = manager.Lock()
    print_lock = manager.Lock()
    active_tasks = manager.dict()
    status_line_len = manager.Value('i', 0)
    completed_counter = manager.Value('i', 0)

    root_existed_at_start = os.path.exists(ROOT_PATH)
    call_proc_dirs = {os.path.abspath(os.path.join(ROOT_PATH, f"proc_{MAIN_PID}"))}

    def cleanup_call_empty_dirs():
        if os.getpid() != MAIN_PID:
            return
        for proc_dir in sorted(call_proc_dirs, key=len, reverse=True):
            if os.path.isdir(proc_dir):
                for dirpath, _, _ in os.walk(proc_dir, topdown=False):
                    try:
                        os.rmdir(dirpath)
                    except OSError:
                        pass
        if not root_existed_at_start and os.path.isdir(ROOT_PATH):
            try:
                os.rmdir(ROOT_PATH)
            except OSError:
                pass

    atexit.register(cleanup_call_empty_dirs)

    builtins.print = _make_locked_print(builtins.print, print_lock, status_line_len)

    stop_monitor = threading.Event()
    monitor_thread = threading.Thread(
        target=_progress_monitor,
        args=(active_tasks, completed_counter, len(tasks), stop_monitor, print_lock, status_line_len),
        daemon=True,
    )
    monitor_thread.start()

    try:
        with mp.Pool(processes=cpu_use_count, initializer=_worker_init,
                     initargs=(cpus, idx_counter, lock, print_lock, active_tasks, status_line_len)) as pool:
            for p in getattr(pool, '_pool', []):
                if getattr(p, 'pid', None):
                    call_proc_dirs.add(os.path.abspath(os.path.join(ROOT_PATH, f"proc_{p.pid}")))
            for res, worker_pid in pool.imap_unordered(_run_task, tasks):
                completed_counter.value += 1
                call_proc_dirs.add(os.path.abspath(os.path.join(ROOT_PATH, f"proc_{worker_pid}")))
                if res:
                    _merge_results(results, res)
    except KeyboardInterrupt:
        print("\nBenchmark interrupted by user.", file=sys.stderr)
        sys.exit(130)
    finally:
        stop_monitor.set()
        monitor_thread.join(timeout=1.0)
        with print_lock:
            if status_line_len.value > 0:
                stream = sys.stderr if sys.stderr.isatty() else (sys.stdout if sys.stdout.isatty() else None)
                if stream is not None:
                    stream.write('\r' + (' ' * status_line_len.value) + '\r')
                    stream.flush()
                status_line_len.value = 0
        cleanup_call_empty_dirs()

    print()
    print(markdown_table(table_titles(args.values), results, values_mode=args.values, highlight=args.highlight_min))


def install_missing_modules():
    try:
        importlib.import_module('psutil')
    except ModuleNotFoundError:
        print("Installing missing modules...")
        import subprocess as sp
        sp.check_call([sys.executable, "-m", "pip", "install", "psutil"])
        print("Missing modules installed successfully.")


if __name__ == '__main__':
    main()

