def long_type_of_lang(lang):
    prop = LANG_PROPERTIES.get(lang.lower())
    if prop:
        return [prop[1]]
    raise NotImplementedError(f"Missing integer type configuration for '{lang}'")


def language_file_extension(lang):
    prop = LANG_PROPERTIES.get(lang.lower())
    return prop[0] if prop else lang.lower()


def generate_test_program_file(lang: str, args: argparse.Namespace, templated: bool, run_ix):
    program_name = DEFAULT_PROGRAM_NAME

    llang = lang.lower()
    types = long_type_of_lang(llang)
    ext = language_file_extension(llang)
    dir_path = os.path.join(ROOT_PATH, llang)
    os.makedirs(dir_path, exist_ok=True)

    path = (os.path.join(dir_path, program_name + ('_t' if templated else '') +
                         ('_' + str(run_ix) if lang.lower() != 'ada' else '') +
                         '.' + ext))

    start = timer()
    import io
    buf = io.StringIO()
    generate_test_language_specific_prefix(llang, program_name, buf, templated=templated)

    if llang == 'ada':
        generate_test_main_header(llang, types, buf, templated)
        generate_main_test_function_definition_set(llang, types, args, buf, templated=templated)
    else:
        generate_main_test_function_definition_set(llang, types, args, buf, templated=templated)
        generate_test_main_header(llang, types, buf, templated)

    for typ in types:
        generate_main_test_function_variable(llang, typ, buf, templated=templated)

    generate_test_main_middle(llang, types, buf, templated)

    for typ in types:
        for findex in range(0, args.function_count):
            generate_test_function_call(llang, findex, typ, buf, templated=templated)

    generate_test_language_specific_postfix(llang, types, buf)

    with open(path, 'w') as fil:
        fil.write(buf.getvalue())
    end = timer()
    dur = (end - start)
    print('- Generating {} took {:1.3f} seconds ({})'.format(path, dur, lang))

    return path


def generate_test_function_call(lang: str, findex, typ, fil, templated: bool):
    n = str(findex)

    if lang in ('c#', 'java'):
        fil.write('    ')

    fn = Tm('add_${T}_n${N}').substitute(T=typ, N=n)

    if lang == 'zig' and templated:
        fil.write(Tm('    ${T}_sum += ${F}(${T}, ${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'v' and templated:
        fil.write(Tm('    ${T}_sum += ${F}[${T}](${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'odin' and templated:
        fil.write(Tm('    ${T}_sum += ${F}(${T}(${N}))').substitute(T=typ, N=n, F=fn))
    elif lang == 'ocaml':
        fil.write(Tm('    let ${T}_sum = ${T}_sum +. (${F} ${N}.0) in').substitute(T=typ, N=n, F=fn))
    elif lang == 'ada':
        fil.write(Tm('   ${T}_sum := ${T}_sum + ${F}(${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'vox':
        fil.write(Tm('    ${T}_sum += ${F}${X}(${N})').substitute(T=typ, N=n, X='[' + typ + ']' if templated else '', F=fn))
    elif lang in ('swift', 'hylo'):
        fil.write(Tm('    ${T}_sum += ${F}(x: ${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'pareas':
        fil.write(Tm('    ${T}_sum = ${T}_sum + ${F}[${N}]').substitute(T=typ, N=n, F=fn))
    elif lang == 'python' or lang == 'mojo':
        fil.write(Tm('    ${T}_sum += ${F}(${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'scheme':
        fil.write(Tm('    (set! ${T}_sum (+ ${T}_sum (${F} ${N})))').substitute(T=typ, N=n, F=fn))
    elif lang == 'crystal':
        fil.write(Tm('    ${T}_sum += ${F}(${N}_i64)').substitute(T=typ.lower(), N=n, F=fn))
    elif lang == 'pascal':
        fil.write(Tm('  ${T}_sum := ${T}_sum + ${F}(${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'haskell':
        fil.write(Tm('    modifyIORef\' ${T}_sum (\\s -> s + ${F} ${N})').substitute(T=typ.lower(), N=n, F=fn))
    elif lang == 'fortran':
        fil.write(Tm('    ${T}_sum = ${T}_sum + ${F}(${N}_${T})').substitute(T=typ, N=n, F=fn))
    elif lang == 'c3':
        fn = "calc::" + fn
        if templated:
            fil.write(Tm('    ${T}_sum += ${F}{${T}}(${N})').substitute(T=typ, N=n, F=fn))
        else:
            fil.write(Tm('    ${T}_sum += ${F}(${N})').substitute(T=typ, N=n, F=fn))
    else:
        fil.write(Tm('    ${T}_sum += ${F}(${N})').substitute(T=typ, N=n, F=fn))

    if lang not in ('ocaml', 'nim', 'v', 'odin', 'scheme', 'crystal', 'haskell', 'fortran'):
        fil.write(';')

    fil.write('\n')


