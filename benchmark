    prefixes = {
        'hare': 'use os;\n\n',
        'fortran': 'module calc\n    use, intrinsic :: iso_fortran_env, only: int64\n    implicit none\ncontains\n',
        'haskell': "module Main where\n\nimport Data.Int (Int64)\nimport Data.IORef (newIORef, modifyIORef', readIORef)\nimport System.Exit (exitWith, ExitCode(..))\n\n",
        'pascal': f"program {program_name};\n\n",
        'go': f"package {program_name};\n// import (\"os\")\n\n",
        'rust': 'use std::process::exit;\n' + ('use std::ops::Add;\n' if templated else ''),
        'swift': 'import Foundation\n\n',
        'hylo': 'import Foundation\n\n',
        'c#': 'using System;\n\npublic class HelloWorld {\n',
        'java': 'class HelloWorld {\n',
        'ada': 'with System;\n\nwith GNAT.OS_Lib;\n\n',
        'odin': f"package {program_name}\n\nimport \"core:os\"\n\n",
        'python': 'import sys\n\n',
        'c3': 'module calc<T>;\n\n' if templated else 'module calc;\n\n',
        'vox': '''enum u32 stdin = 0;
enum u32 stdout = 1;
enum u32 stderr = 2;

@extern(syscall, 60)
void exit(i32 error_code);

