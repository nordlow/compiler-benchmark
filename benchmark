def build_compiler_cmd(cexe: str, cexe_flags: list, out_flags: list, src_name: str, has_stdin: bool) -> list:
    """Construct command arguments, factoring out compiler-specific ordering (e.g., Odin)."""
    if has_stdin:
        return [cexe] + cexe_flags + out_flags
    if os.path.basename(cexe).startswith('odin'):
        cmd = [cexe_flags[0]] if cexe_flags else []
        remaining = cexe_flags[1:] if cexe_flags else []
        return [cexe] + cmd + [src_name, '-file'] + remaining + out_flags
    return [cexe] + cexe_flags + out_flags + [src_name]


def measure_compilation(p_args: list, work_dir: str, sample_rate: int, stdin_text: str | None = None):
    """Execute compiler in work_dir and measure duration, RSS, and exit code."""
    from process_timer import ProcessTimer
    cwd = os.getcwd()
    os.chdir(work_dir)
    cstart = timer()
    outs, errs = b'', b''
    returncode = -1
    rss_mu = None

    try:
        if stdin_text is not None:
            import psutil
            comp_proc = sp.Popen(p_args, stdin=sp.PIPE, stdout=sp.PIPE, stderr=sp.PIPE)
            comp_proc.stdin.write(stdin_text.encode('utf-8'))
            comp_proc.stdin.close()
            try:
                p = psutil.Process(comp_proc.pid)
                max_rss = 0
                while comp_proc.poll() is None:
                    try:
                        rss = p.memory_info().rss
                        if rss > max_rss:
                            max_rss = rss
                    except (psutil.NoSuchProcess, psutil.AccessDenied):
                        break
                    time.sleep(1.0 / sample_rate)
                rss_mu = max_rss if max_rss > 0 else "missing"
            except Exception:
                rss_mu = "sampling error"
            outs, errs = comp_proc.communicate()
            returncode = comp_proc.returncode
        else:
            pt = ProcessTimer(args=p_args)
            try:
                while pt.poll():
                    time.sleep(1.0 / sample_rate)
            except Exception:
                rss_mu = "sampling error"
            finally:
                if rss_mu is None and getattr(pt, 'max_rss_mu', 0) != 0:
                    rss_mu = pt.max_rss_mu
                rss_mu = rss_mu or "missing"

            outs, errs = pt.comp_proc.communicate()
            returncode = pt.comp_proc.returncode
    finally:
        os.chdir(cwd)

    dur = timer() - cstart
    return dur, returncode, outs, errs, rss_mu


def run_target_binary(cexe: str, lang: str, lang_dir: str, runner, op: str, src_name: str, run_count: int):
    """Execute target binary or script, handling compiler-specific quirks."""
    if op == 'build' and runner:
        outb_path = os.path.join(lang_dir, out_binary(lang))
        if runner is True:
            if os.path.exists(outb_path) and not os.access(outb_path, os.X_OK):
                os.chmod(outb_path, os.stat(outb_path).st_mode | stat.S_IEXEC | stat.S_IXGRP | stat.S_IXOTH)
            return run_compiled_file(outb_path, run_count=run_count)
        if isinstance(runner, list):
            return run_compiled_file(runner + [outb_path], run_count=run_count)

    return None


def compile_file(code_paths: list,
                 out_flag_and_exe: list,
                 cexe: str,
                 runner,
                 cexe_flags: list[str],
                 args: argparse.Namespace,
                 op: str,
                 compiler_version: str | None = None,
                 lang: str = None,
                 templated: bool = False,
                 results: dict = {},
                 stdin_input: str | None = None):
    key = (lang, templated, cexe)
    row = results.setdefault(key, [None] * RAW_ROW_LENGTH)
    row[LANG_IX] = lang
    row[TEMPLATED_IX] = 'Yes' if templated else 'No'
    row[CEXE_VERSION_IX] = compiler_version
    row[CEXE_PATH_IX] = os.path.basename(cexe)
    lang_dir = os.path.abspath(out_directory(lang))
    total_funcs = args.function_count * args.function_depth

    durs = []
    rss_mu = None

    for run_ix in range(args.run_count):
        src_key = sourceIdOf(lang, templated, run_ix)
        if src_key in code_paths:
            src_path = code_paths[src_key]
        else:
            src_path = generate_test_program_file(lang, args, templated, run_ix)
            code_paths[src_key] = src_path
        src_name = os.path.basename(src_path)

        p_args = build_compiler_cmd(cexe, cexe_flags, out_flag_and_exe, src_name, has_stdin=bool(stdin_input))
        stdin_text = stdin_input.format(run_ix) if stdin_input else None

        dur, returncode, outs, errs, rss = measure_compilation(p_args, lang_dir, args.sample_rate, stdin_text)
        rss_mu = rss

        if returncode != 0 and op != 'run':
            cmd_str = ' '.join(p_args)
            err_str = errs.decode('utf8', errors='ignore') if errs else ''
            print(f"WARNING: Compilation `{cmd_str}` of source file `{src_name}` exited with return code {returncode}", file=sys.stderr)
            if err_str:
                print(f"  - stderr: {err_str}", file=sys.stderr)
            if rss_mu and isinstance(rss_mu, (int, float)):
                slot = CHECK_RSS_MU_IX if op == 'check' else (BUILD_RSS_MU_IX if op == 'build' else None)
                if slot:
                    row[slot] = rss_mu / total_funcs
            return None

        durs.append(dur)

    dur_min = min(durs)
    run_dur_min = run_target_binary(cexe, lang, lang_dir, runner, op, src_name, args.run_count)

    output_size = None
    if op == 'build':
        outb_path = os.path.join(lang_dir, out_binary(lang))
        if is_machine_code_binary(outb_path, lang, cexe):
            try:
                output_size = os.path.getsize(outb_path)
            except OSError:
                output_size = None

    version_str = f' version {compiler_version}' if compiler_version is not None else ''
    cop = op.capitalize()
    print(f'- {cop} took {dur_min:1.3f} seconds (using "{cexe}"{version_str})')

    row[LANG_IX] = lang
    row[TEMPLATED_IX] = 'Yes' if templated else 'No'
    row[CEXE_VERSION_IX] = compiler_version
    row[CEXE_PATH_IX] = os.path.basename(cexe)

    op_dur_col = {
        'ast-check': AST_CHECK_DUR_PER_FUNC_IX,
        'check': CHECK_DUR_PER_FUNC_IX,
        'compile': COMPILE_DUR_PER_FUNC_IX,
        'build': BUILD_DUR_PER_FUNC_IX,
        'run': RUN_DUR_PER_FUNC_IX,
    }.get(op)
    if op_dur_col is not None:
        row[op_dur_col] = dur_min / total_funcs

    if run_dur_min is not None:
        row[RUN_DUR_PER_FUNC_IX] = run_dur_min / total_funcs

    op_rss_col = {'check': CHECK_RSS_MU_IX, 'build': BUILD_RSS_MU_IX}.get(op)
    if op_rss_col is not None and rss_mu is not None:
        row[op_rss_col] = (rss_mu / total_funcs) if isinstance(rss_mu, (int, float)) else rss_mu

    if output_size is not None:
        row[OUTPUT_SIZE_IX] = output_size / total_funcs

    return row



def run_compiled_file(args: argparse.Namespace, run_count=1):
    durs = []
    for _ in range(0, run_count):
        cstart = timer()
        sp.run(args, stdout=sp.DEVNULL, stderr=sp.DEVNULL)
        durs.append(timer() - cstart)
    return min(durs) if durs else None


