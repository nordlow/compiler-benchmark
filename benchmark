    elif op == 'compile':
        cexe_flags = ['-c']
        out_flag_and_exe = []
    elif op == 'build':
        cexe_flags = []
        out_flag_and_exe = ['-o', out_binary(lang)]
    else:
        return None

    version = "~master"
    benchmark_compiler_op(code_paths,
                 out_flag_and_exe=out_flag_and_exe,
                 cexe=cexe,
                 exec_cmd=(op == 'build'),
                 cexe_flags=cexe_flags,
