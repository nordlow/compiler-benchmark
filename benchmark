        bindings = ' '.join([f'({typ}_sum 0)' for typ in types])
        fil.write(f'  (let ({bindings})\n')


def generate_main_test_function_variable(lang: str, typ, fil, templated: bool):
    if lang in ('c', 'c3', 'c++', 'd', 'vox'):
        fil.write(f"    {typ} {typ}_sum = 0;\n")
    elif lang in ('c#', 'java'):
        fil.write(f"        {typ} {typ}_sum = 0;\n")
    elif lang in ('swift', 'hylo', 'nim', 'zig', 'pareas', 'mojo'):
        fil.write(f"    var {typ}_sum: {typ} = 0;\n")
    elif lang == 'go':
        fil.write(f"    var {typ}_sum {typ} = 0;\n")
    elif lang == 'rust':
        fil.write(f"    let mut {typ}_sum : {typ} = 0;\n")
    elif lang in ('odin', 'hare'):
        fil.write(f"    {typ}_sum: {typ} = 0\n" if lang == 'odin' else f"    let {typ}_sum: {typ} = 0;\n")
    elif lang == 'v':
        fil.write(f"    mut {typ}_sum := {typ}(0)\n")
    elif lang == 'julia':
        qt = f"::{typ}" if templated else ""
        fil.write(f"    {typ}_sum{qt} = 0;\n")
    elif lang == 'ocaml':
        fil.write(f"    let {typ}_sum = 0.0 in\n")
    elif lang == 'python':
        fil.write(f"    {typ}_sum: {typ} = 0\n" if templated else f"    {typ}_sum = 0\n")
    elif lang == 'crystal':
        fil.write(f"    {typ.lower()}_sum = 0_i64\n")
    elif lang == 'pascal':
        fil.write(f"  {typ}_sum: {typ};\n")
    elif lang == 'haskell':
        fil.write(f"    {typ.lower()}_sum <- newIORef (0 :: {typ})\n")
    elif lang == 'fortran':
        fil.write(f"    integer({typ}) :: {typ}_sum\n")
    elif lang == 'ada':
        fil.write(f"   {typ}_sum : {typ} := 0;\n")


