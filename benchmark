def is_machine_code_binary(path: str, lang: str, cexe: str) -> bool:
    if not os.path.isfile(path):
        return False
    if lang.lower() in ('python', 'java', 'c#', 'julia', 'scheme', 'lua', 'typescript', 'guile'):
        return False
    if os.path.basename(cexe).startswith('ocamlc'):
        return False
    try:
        with open(path, 'rb') as f:
            magic = f.read(4)
            macho_magics = {
                bytes([0xfe, 0xed, 0xfa, 0xce]),
                bytes([0xfe, 0xed, 0xfa, 0xcf]),
                bytes([0xce, 0xfa, 0xed, 0xfe]),
                bytes([0xcf, 0xfa, 0xed, 0xfe]),
                bytes([0xca, 0xfe, 0xba, 0xbe]),
            }
            return (
                magic.startswith(bytes([0x7f, 0x45, 0x4c, 0x46])) or
                magic in macho_magics or
                (magic.startswith(b"MZ") and lang.lower() != 'c#')
            )
    except OSError:
        return False


