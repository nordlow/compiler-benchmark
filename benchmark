def _worker_init(cpu_list, idx_counter, lock, print_lock):
    with lock:
        idx = idx_counter.value
        idx_counter.value += 1
    cpu_id = cpu_list[idx % len(cpu_list)]
    if hasattr(os, 'sched_setaffinity'):
        try:
            os.sched_setaffinity(0, {cpu_id})
        except Exception:
            pass
    orig_print = builtins.print
    def _locked_print(*args, **kwargs):
        with print_lock:
            orig_print(*args, **kwargs)
            sys.stdout.flush()
    builtins.print = _locked_print


def _run_task(task):
    b_idx, r_idx, op, templated, task_args = task
    lang, runners, _, _ = LANGUAGE_BENCHMARKS[b_idx]
    runner = runners[r_idx]
    task_results, task_code_paths = {}, {}
    success = False
    try:
        runner(task_results, task_code_paths, task_args, op, templated)
        success = True
    finally:
        if success:
            shutil.rmtree(out_directory(lang), ignore_errors=True)
    return task_results


def _merge_results(target, incoming):
    for key, row in incoming.items():
        if key not in target:
            target[key] = list(row)
        else:
            for i, val in enumerate(row):
                if val is not None:
                    target[key][i] = val



def main():
    parser = argparse.ArgumentParser(formatter_class=argparse.ArgumentDefaultsHelpFormatter)

    parser.add_argument('--languages', '--langs', type=str,
                        default=','.join(LANGUAGE_EXES.keys()),
                        help='Languages (optionally combined with compilers) to benchmark separated by comma. For instance --languages=C:tcc,D:dmd,D:gdc,D:ldmd2.')

    parser.add_argument('--path', type=str,
                        default=None,
                        help='Path in which to look for compilers')

    parser.add_argument('--operations', '--ops', type=str,
                        default=','.join(SUPPORTED_OPERATIONS),
                        help='Operations to perform separated by comma')

    parser.add_argument('--function-count', '--fc', type=int,
                        default=200,
                        help='Number of functions generated and called')

    parser.add_argument('--function-depth', '--fd', type=int,
                        default=200,
                        help='Function call depth')

    parser.add_argument('--sample-rate', '--sr', type=int,
                        default=100,
                        help='Rate of memory usage sampling. Unit is samples per second.')

    parser.add_argument('--run-count', '--rc', type=int,
                        default=5,
                        help='Number of runs for each compilation')

    parser.add_argument('--values', '--val', type=str,
                        choices=['absolute', 'relative', 'both'],
                        default='absolute',
                        help='Whether to display absolute, relative, or both numeric values in the table.')

    parser.add_argument('--relative', '--rel', action='store_true',
                        help='Display relative numeric values (shortcut for --values=relative).')

    args = parser.parse_args()
    if args.relative:
        args.values = 'relative'
    install_missing_modules()

    lang_aliases = {
        'hare': 'Hare',
        'fortran': 'Fortran',
        'gfortran': 'Fortran',
        'haskell': 'Haskell',
        'ghc': 'Haskell',
        'pascal': 'Pascal',
        'fpc': 'Pascal',
        'scheme': 'Scheme',
        'chez': 'Scheme',
        'ocaml': 'OCaml',
    }

    def normalize_lang_spec(spec: str) -> str:
        name, sep, exes = spec.partition(':')
        canonical = lang_aliases.get(name.lower(), name.capitalize())
        return f"{canonical}{sep}{exes}" if sep else canonical

    args.languages = [
        normalize_lang_spec(spec.strip())
        for spec in args.languages.split(',')
        if spec.strip()
    ]
    args.language_exes = {}
    for language_exes_spec in args.languages:
        split = language_exes_spec.split(':')
        if len(split) == 2:
            language = split[0]
            exes = split[1]. split(',')
        else:
            language = split[0]
            exes = []
        if language not in LANGUAGE_EXES:
            print('Warning: Ignoring unsupported language ' + language)
            continue
        if language in args.language_exes:
            args.language_exes[language] += exes
        else:
            args.language_exes[language] = exes
    if not args.language_exes:
        args.language_exes = LANGUAGE_EXES

    args.operations = list(map(lambda x: x.lower(), args.operations.split(',')))
    filtered_operations = []
    for operation in args.operations:
        if operation in SUPPORTED_OPERATIONS:
            filtered_operations.append(operation)
        else:
            print('Warning: Ignoring unsupported operation ' + operation)
    args.operations = filtered_operations

    code_paths = {}
    results = {}

    print(markdown_header('Benchmark:', 1))

    tasks = []
    for op in args.operations:
        for b_idx, (lang, runners, ops, templated_variants) in enumerate(LANGUAGE_BENCHMARKS):
            if lang not in args.language_exes or op not in ops:
                continue

            task_args = copy.deepcopy(args)
            # These languages scale poorly on deeply nested functions with large synthetic function counts[1], an explicit limit is enforced:
            if lang in ('OCaml', 'Julia') and task_args.function_count * task_args.function_depth >= 10000:
                task_args.function_count, task_args.function_depth = 200, 200
            # Nim compiler has a hard limit of 50 recursive generic instantiations:
            if lang == 'Nim' and task_args.function_depth > 50:
                print(f"Warning: Capping Nim function depth (--function-depth) from {task_args.function_depth} to 50 due to compiler generic recursion limit")
                task_args.function_depth = 50

            for templated in templated_variants:
                for r_idx in range(len(runners)):
                    tasks.append((b_idx, r_idx, op, templated, task_args))

    cpus = get_available_cpus()
    print(f"Running benchmarks in parallel across {len(cpus)} CPU core(s) (1 worker per core)...")
    manager = mp.Manager()
    idx_counter = manager.Value('i', 0)
    lock = manager.Lock()
    print_lock = manager.Lock()

    orig_print = builtins.print
    def _locked_print(*args, **kwargs):
        with print_lock:
            orig_print(*args, **kwargs)
            sys.stdout.flush()
    builtins.print = _locked_print

    with mp.Pool(processes=len(cpus), initializer=_worker_init,
                 initargs=(cpus, idx_counter, lock, print_lock)) as pool:
        for res in pool.imap_unordered(_run_task, tasks):
            if res:
                _merge_results(results, res)

    print()
    print(markdown_table(MARKDOWN_TABLE_TITLES, results, values_mode=args.values))


def install_missing_modules():
    try:
        importlib.import_module('psutil')
    except ModuleNotFoundError:
        print("Installing missing modules...")
        import subprocess as sp
        sp.check_call([sys.executable, "-m", "pip", "install", "psutil"])
        print("Missing modules installed successfully.")


if __name__ == '__main__':
    main()
