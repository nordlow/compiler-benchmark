def long_type_of_lang(lang: str) -> list[TypeName]:
    prop = LANG_PROPERTIES.get(Lang(lang.lower()))
    if prop:
        return [prop.int_type]
    raise NotImplementedError(f"Missing integer type configuration for '{lang}'")


def language_file_extension(lang: str) -> FileExt:
    prop = LANG_PROPERTIES.get(Lang(lang.lower()))
    return prop.extension if prop else FileExt(lang.lower())


def generate_test_program_file(lang: str, args: argparse.Namespace, templated: bool, run_ix):
    program_name = DEFAULT_PROGRAM_NAME

    llang = lang.lower()
    types = long_type_of_lang(llang)
    ext = language_file_extension(llang)
    dir_path = out_directory(lang)

    if llang == 'pony':
        # ponyc compiles an entire package directory rather than a single
        # file, so isolate each generated program in its own subdirectory
        # to avoid multiple `actor Main` definitions colliding.
        dir_path = os.path.join(dir_path, 'run' + ('_t' if templated else '') + '_' + str(run_ix))

    os.makedirs(dir_path, exist_ok=True)

    path = (os.path.join(dir_path, program_name + ('_t' if templated else '') +
                         ('_' + str(run_ix) if lang.lower() != 'ada' else '') +
                         '.' + ext))

    start = timer()
    import io
    buf = io.StringIO()
    generate_test_language_specific_prefix(llang, program_name, buf, templated=templated)

    if llang == 'ada':
        generate_test_main_header(llang, types, buf, templated)
        generate_main_test_function_definition_set(llang, types, args, buf, templated=templated)
    else:
        generate_main_test_function_definition_set(llang, types, args, buf, templated=templated)
        generate_test_main_header(llang, types, buf, templated)

    for typ in types:
        generate_main_test_function_variable(llang, typ, buf, templated=templated)

    generate_test_main_middle(llang, types, buf, templated)

    for typ in types:
        for findex in range(0, args.function_count):
            generate_test_function_call(llang, findex, typ, buf, templated=templated)

    generate_test_language_specific_postfix(llang, types, buf)

    with open(path, 'w') as sink:
        sink.write(buf.getvalue())
    end = timer()
    dur = (end - start)
    print('- Generating {} took {:1.3f} seconds ({})'.format(path, dur, lang))

    return path


def generate_test_function_call(lang: str, findex, typ, sink, templated: bool):
    n = str(findex)

    if lang in ('c#', 'java'):
        sink.write('    ')

    fn = Tm('add_${T}_n${N}').substitute(T=typ, N=n)

    if lang == 'zig' and templated:
        sink.write(Tm('    ${T}_sum += ${F}(${T}, ${N})').substitute(T=typ, N=n, F=fn))
    elif lang in ('nim', 'v') and templated:
        sink.write(Tm('    ${T}_sum += ${F}[${T}](${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'odin' and templated:
        sink.write(Tm('    ${T}_sum += ${F}(${T}(${N}))').substitute(T=typ, N=n, F=fn))
    elif lang == 'ocaml':
        sink.write(Tm('    let ${T}_sum = ${T}_sum +. (${F} ${N}.0) in').substitute(T=typ, N=n, F=fn))
    elif lang == 'ada':
        sink.write(Tm('   ${T}_sum := ${T}_sum + ${F}(${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'vox':
        sink.write(Tm('    ${T}_sum += ${F}${X}(${N})').substitute(T=typ, N=n, X='[' + typ + ']' if templated else '', F=fn))
    elif lang in ('swift', 'hylo'):
        sink.write(Tm('    ${T}_sum += ${F}(x: ${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'pareas':
        sink.write(Tm('    ${T}_sum = ${T}_sum + ${F}[${N}]').substitute(T=typ, N=n, F=fn))
    elif lang == 'python' or lang == 'mojo':
        sink.write(Tm('    ${T}_sum += ${F}(${N})').substitute(T=typ, N=n, F=fn))
    elif lang in ('scheme', 'guile'):
        sink.write(Tm('    (set! ${T}_sum (+ ${T}_sum (${F} ${N})))').substitute(T=typ, N=n, F=fn))
    elif lang == 'crystal':
        sink.write(Tm('    ${T}_sum += ${F}(${N}_i64)').substitute(T=typ.lower(), N=n, F=fn))
    elif lang == 'pascal':
        sink.write(Tm('  ${T}_sum := ${T}_sum + ${F}(${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'haskell':
        sink.write(Tm('    modifyIORef\' ${T}_sum (\\s -> s + ${F} ${N})').substitute(T=typ.lower(), N=n, F=fn))
    elif lang == 'fortran':
        sink.write(Tm('    ${T}_sum = ${T}_sum + ${F}(${N}_${T})').substitute(T=typ, N=n, F=fn))
    elif lang == 'c3':
        fn = "calc::" + fn
        if templated:
            sink.write(Tm('    ${T}_sum += ${F}{${T}}(${N})').substitute(T=typ, N=n, F=fn))
        else:
            sink.write(Tm('    ${T}_sum += ${F}(${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'lua':
        sink.write(Tm('    ${T}_sum = ${T}_sum + ${F}(${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'pony':
        sink.write(Tm('    ${T}_sum = ${T}_sum + Calc.${F}(${N})').substitute(T=typ.lower(), N=n, F=fn))
    elif lang in ('typescript', 'dart') and templated:
        sink.write(Tm('    ${T}_sum += ${F}<${T}>(${N})').substitute(T=typ, N=n, F=fn))
    elif lang == 'common lisp':
        sink.write(Tm('    (setf ${T}_sum (+ ${T}_sum (${F} ${N})))').substitute(T=typ, N=n, F=fn))
    else:
        sink.write(Tm('    ${T}_sum += ${F}(${N})').substitute(T=typ, N=n, F=fn))

    if lang not in ('ocaml', 'nim', 'v', 'odin', 'scheme', 'crystal', 'haskell', 'fortran', 'lua', 'pony', 'common lisp', 'guile'):
        sink.write(';')

    sink.write('\n')


