def merge_plain_and_templated_results(results: Results):
    metric_cols = [
        AST_CHECK_DUR_PER_FUNC_IX,
        CHECK_DUR_PER_FUNC_IX,
        COMPILE_DUR_PER_FUNC_IX,
        BUILD_DUR_PER_FUNC_IX,
        RUN_DUR_PER_FUNC_IX,
        CHECK_RSS_MU_IX,
        BUILD_RSS_MU_IX,
        OUTPUT_SIZE_IX,
    ]
    merged = {}
    grouped = {}
    for (lang, templated, cexe), row in results.items():
        grouped.setdefault((lang, cexe), {})[templated] = row

    for (lang, cexe), variants in grouped.items():
        row_plain = variants.get(False)
        row_tmpl = variants.get(True)
        base_row = row_plain if row_plain is not None else row_tmpl
        merged_row = [base_row[LANG_IX]]

        for col in metric_cols:
            val_p = str(row_plain[col]).strip() if row_plain and row_plain[col] is not None else None
            val_t = str(row_tmpl[col]).strip() if row_tmpl and row_tmpl[col] is not None else None

            p_na = (val_p is None or val_p == 'N/A')
            t_na = (val_t is None or val_t == 'N/A')

            if p_na and t_na:
                cell = 'N/A'
            elif row_tmpl is None:  # Language has no templated variant benchmarked
                cell = f"{val_p} / -" if not p_na else 'N/A'
            elif p_na:
                cell = f"- / {val_t}"
            elif t_na:
                cell = f"{val_p} / -"
            else:
                cell = f"{val_p} / {val_t}"
            merged_row.append(cell)

        merged_row.extend([base_row[CEXE_VERSION_IX], base_row[CEXE_PATH_IX]])
        merged[(lang, cexe)] = merged_row

    return merged


def markdown_table(titles: list[str], results: Results, values_mode: str = 'absolute'):
    fill_in_speedups(results=results, column_ix=AST_CHECK_DUR_PER_FUNC_IX, values_mode=values_mode)
    fill_in_speedups(results=results, column_ix=CHECK_DUR_PER_FUNC_IX, values_mode=values_mode)
    fill_in_speedups(results=results, column_ix=COMPILE_DUR_PER_FUNC_IX, values_mode=values_mode)
    fill_in_speedups(results=results, column_ix=BUILD_DUR_PER_FUNC_IX, values_mode=values_mode)
    fill_in_speedups(results=results, column_ix=RUN_DUR_PER_FUNC_IX, values_mode=values_mode)
    fill_in_speedups(results=results, column_ix=CHECK_RSS_MU_IX, values_mode=values_mode)
    fill_in_speedups(results=results, column_ix=BUILD_RSS_MU_IX, values_mode=values_mode)
    fill_in_speedups(results=results, column_ix=OUTPUT_SIZE_IX, values_mode=values_mode)

    merged_results = merge_plain_and_templated_results(results)

    # Sort rows by Language, then Compiler Executable
    sorted_rows = sorted(merged_results.values(), key=lambda r: (r[0].lower(), str(r[-1]).lower()))

    # Compute dynamic column widths for proper markdown alignment
    col_widths = [len(t) for t in titles]
    for row in sorted_rows:
        for idx, cell in enumerate(row):
            col_widths[idx] = max(col_widths[idx], len(str(cell)))

    # Header
    result = '| ' + ' | '.join(str(titles[i]).ljust(col_widths[i]) for i in range(len(titles))) + ' |\n'
    # Separator
    result += '| ' + ' | '.join(':' + '-' * (col_widths[i] - 2) + ':' for i in range(len(titles))) + ' |\n'
    # Data rows
    for row in sorted_rows:
        result += '| ' + ' | '.join(str(row[i]).ljust(col_widths[i]) for i in range(len(row))) + ' |\n'
    return result


def match_lang_cexe(args: argparse.Namespace, lang: str, cexe_name: str):
    try:
        if args.language_exes[lang] and cexe_name not in args.language_exes[lang]:
            return None
    except KeyError:
        pass
    cexe_path = which(cexe_name, path=args.path)
    return cexe_path


