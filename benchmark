def generate_test_language_specific_postfix(lang: str, types: list, fil):
    t = types[0]
    tl = t.lower()
    postfixes = {
        'rust': f"    exit(({t}_sum % 4294967296) as i32);\n}}\n",
        'd': f"    return cast(int){t}_sum;\n}}\n",
        'nim': f"    quit(int({t}_sum))\n\n",
        'swift': f"    exit(Int32({t}_sum))\n}}\n",
        'hylo': f"    exit(Int32({t}_sum))\n}}\n",
        'go': f"    // os.Exit(int({t}_sum));\n}}\n",
        'c#': f"        Environment.Exit({t}_sum == 42 ? 1 : 0);\n    }}\n}}\n",
        'java': f"        System.exit({t}_sum == 42 ? 1 : 0);\n    }}\n}}\n",
        'zig': "\n}\n",
        'c3': f"        return (int)({t}_sum);\n}}\n",
        'pareas': f"    return {t}_sum;\n}}\n",
        'python': f"    sys.exit(int({t}_sum) & 0xFFFFFFFF)\n\nif __name__ == '__main__':\n    main()\n",
        'mojo': f"    sys.exit(int({t}_sum) & 0xFFFFFFFF)\n\nif __name__ == '__main__':\n    main()\n",
        'julia': f"    return {t}_sum;\nend\n\nmain()\n",
        'vox': "    exit(0);\n    return 0;\n}\n",
        'ada': f"   GNAT.OS_Lib.OS_Exit(Integer({t}_sum));\nend Main;\n",
        'ocaml': f"    exit (if {t}_sum = 42.0 then 1 else 0)\n",
        'odin': f"    os.exit(int({t}_sum))\n}}\n",
        'v': f"    exit(int({t}_sum >> 32))\n}}\n",
        'scheme': f"    {t}_sum))\n(exit (main))\n",
        'crystal': f"    exit(({tl}_sum % 256).to_i32)\nend\n\nmain()\n",
        'pascal': f"  Halt({t}_sum mod 256);\nend.\n",
        'haskell': f"    s <- readIORef {tl}_sum\n    let code = fromIntegral (s `mod` 256)\n    exitWith (if code == 0 then ExitSuccess else ExitFailure code)\n",
        'fortran': f"    call exit(int(mod({t}_sum, 256_{t})))\nend program main\n",
        'hare': f"    os::exit(({t}_sum % 256): int);\n}};\n",
        'c': f"    return {t}_sum;\n}}\n",
        'c++': f"    return {t}_sum;\n}}\n",
    }
    if lang in postfixes:
        fil.write(postfixes[lang])
    else:
        raise NotImplementedError(f"Language '{lang}' has no postfix exit handler defined")


def generate_main_test_function_definition_set(lang: str, types: list[str], args: argparse.Namespace, fil, templated: bool):
    for typ in types:
        for findex in range(0, args.function_count):
            for fheight in range(0, args.function_depth):
                generate_test_function_definition(args, lang, typ, findex, fheight, fil, templated=templated)
            fil.write('\n')
        fil.write('\n')


def function_name(typ, findex, fheight):
    if fheight is not None:
        return Tm('add_${T}_n${N}_h${H}').substitute(T=typ,
                                                     N=str(findex),
                                                     H=str(fheight))
    else:
        return Tm('add_${T}_n${N}').substitute(T=typ,
                                               N=str(findex))


def generate_test_function_definition(args: argparse.Namespace, lang: str, typ, findex: int, fheight: int, fil, templated: bool):
    if RANDOMIZE_FLAG:
        nconst = str(random.randint(0, 100000))
    else:
        nconst = str(findex)

    if fheight == 0:
        if lang == 'rust' and templated:
            expr = 'x'
        elif lang == 'ocaml':
            expr = 'x +. ' + nconst + '.0'
        elif lang == 'scheme':
            expr = f'(+ x {nconst})'
        elif lang == 'c3' and templated:
            expr = 'x + (Type)' + nconst
        else:
            expr = 'x + ' + nconst
    else:
        if lang == 'zig' and templated:
            xtarg = typ + ', '
        else:
            xtarg = ''
        if lang == 'rust' and templated:
            call = function_name(typ, findex, fheight - 1) + '(' + xtarg + 'x)'
            expr = 'x + ' + call
        elif lang == 'v' and templated:
            call = function_name(typ, findex, fheight - 1) + Tm('[${T}](x)').substitute(T=typ)
            expr = 'x + ' + call
        elif lang == 'vox' and templated:
            call = function_name(typ, findex, fheight - 1) + Tm('[${T}](x)').substitute(T=typ)
            expr = 'x + ' + call
        elif lang == 'ocaml':
            expr = 'x +. (' + function_name(typ, findex, fheight - 1) + xtarg + ' x) +. ' + nconst + '.0'
        elif lang in ('swift', 'hylo'):
            expr = 'x + ' + function_name(typ, findex, fheight - 1) + '(x: ' + xtarg + 'x) + ' + nconst
        elif lang == 'pareas':
            expr = 'x + ' + function_name(typ, findex, fheight - 1) + '[x] + ' + nconst
        elif lang == 'mojo':
            expr = 'x + ' + function_name(typ, findex, fheight - 1) + '(x) + ' + nconst
        elif lang == 'haskell':
            expr = 'x + ' + function_name(typ, findex, fheight - 1) + ' x + ' + nconst
        elif lang == 'scheme':
            call = function_name(typ, findex, fheight - 1)
            expr = f'(+ x ({call} x) {nconst})'
        else:
            expr = 'x + ' + function_name(typ, findex, fheight - 1) + '(' + xtarg + 'x) + ' + nconst

    if fheight == args.function_depth - 1:
        fname = function_name(typ, findex, fheight=None)
    else:
        fname = function_name(typ, findex, fheight)

    if lang in ('c'):
        fil.write(Tm('${T} ${F}(${T} x) { return ${X}; }\n').substitute(T=typ, F=str(fname), N=nconst, X=expr))
    elif lang in ('c3'):
        if templated:
            fil.write(Tm('fn Type ${F}(Type x) <Type> { return ${X}; }\n').substitute(
                F=str(fname),
                X=expr))
        else:
            fil.write(Tm('fn ${T} ${F}(${T} x) { return ${X}; }\n').substitute(
                T=typ,
                F=str(fname),
                X=expr))
    elif lang in ['ada']:
        fil.write(Tm('''   function ${F} (x: ${T}) return ${T} is (${X});
''').substitute(T=typ, F=str(fname), N=nconst, X=expr))
    elif lang in ['c#']:
        fil.write(Tm('    static ${T} ${F}(${T} x) { return ${X}; }\n').substitute(T=typ, F=str(fname), N=nconst, H=str(fheight), X=expr))
    elif lang in ['java']:
        fil.write(Tm('    static ${T} ${F}(${T} x) { return ${X}; }\n').substitute(T=typ, F=str(fname), N=nconst, H=str(fheight), X=expr))
    elif lang in ['c++']:
        fil.write(Tm('${M}${T} ${F}($T x) { return ${X}; }\n')
                .substitute(T=typ, F=str(fname), N=nconst, H=str(fheight),
                            M='template<typename T=int> ' if templated else '',
                            X=expr))
    elif lang in ('d', 'vox'):
        fil.write(Tm('${T} ${F}${M}(${T} x)${Q} { return ${X}; }\n')
                .substitute(T='T' if templated else typ,
                            F=str(fname),
                            N=nconst,
                            H=str(fheight),
                            M=('(T)' if lang == 'd' else '[T]') if templated else '',
                            Q=' @safe pure nothrow @nogc' if lang == 'd' else '',
                            X=expr))
    elif lang == 'rust':
        if templated:
            fil.write(Tm('fn ${F}<${T} : ${R}>(x: ${T}) -> ${T} { ${X} }\n').substitute(T='T',
                                                                                      R='Copy + Add<Output = T>',
                                                                                      F=str(fname),
                                                                                      N=nconst,
                                                                                      H=str(fheight),
                                                                                      X=expr))
        else:
            fil.write(Tm('fn ${F}(x: ${T}) -> ${T} { ${X} }\n').substitute(T=typ, F=str(fname), N=nconst, H=str(fheight), X=expr))
    elif lang in ('swift', 'hylo'):
        if templated:
            fil.write(Tm('func ${F}<${T}: BinaryInteger>(x: ${T}) -> ${T} { return ${X} }\n').substitute(T='T',
                                                                                        F=str(fname),
                                                                                        N=nconst,
                                                                                        H=str(fheight),
                                                                                        X=expr))
        else:
            fil.write(Tm('func ${F}(x: ${T}) -> ${T} { return ${X} }\n').substitute(T=typ, F=str(fname), N=nconst, H=str(fheight), X=expr))
    elif lang == 'nim':
        if templated:
            fil.write(Tm('proc ${F}[${T}](x: ${T}): ${T} =\n  return ${X}\n').substitute(T='T',
                                                                                       F=str(fname),
                                                                                       N=nconst,
                                                                                       H=str(fheight),
                                                                                       X=expr))
        else:
            fil.write(Tm('proc ${F}(x: ${T}): ${T} = \n  return ${X}\n').substitute(T=typ, F=str(fname), N=nconst, H=str(fheight), X=expr))
    elif lang == 'c3':
        if templated:
            fil.write(Tm('fn ${F}<${T}>(x: ${T}) -> ${T} { return ${X} }\n').substitute(T='T',
                                                                                        F=str(fname),
                                                                                        N=nconst,
                                                                                        H=str(fheight),
                                                                                        X=expr))
        else:
            fil.write(Tm('fn ${T} ${F}(${T} x) { return ${X} }\n').substitute(T=typ, F=str(fname), N=nconst, H=str(fheight), X=expr))
    elif lang == 'zig':
        if templated:
            fil.write(Tm('fn ${F}(comptime T: type, x: T) T { return ${X}; }\n').substitute(T=typ, F=str(fname), N=nconst, H=str(fheight), X=expr))
        else:
            fil.write(Tm('fn ${F}(x: ${T}) ${T} { return ${X}; }\n').substitute(T=typ, F=str(fname), N=nconst, H=str(fheight), X=expr))
    elif lang == 'go':
        fil.write(Tm('func ${F}(x ${T}) ${T} { return ${X} }\n').substitute(T=typ, F=str(fname), N=nconst, H=str(fheight), X=expr))
    elif lang == 'ocaml':
        fil.write(Tm('let ${F} x = ${X}\n').substitute(F=str(fname), X=expr))
    elif lang == 'v':
        if templated:
            fil.write(Tm('fn ${F}[${T}](x ${T}) ${T} { return ${X} }\n').substitute(T='T', F=str(fname), N=nconst, H=str(fheight), X=expr))
        else:
            fil.write(Tm('fn ${F}(x ${T}) ${T} { return ${X} }\n').substitute(T=typ, F=str(fname), N=nconst, H=str(fheight), X=expr))
    elif lang == 'julia':
