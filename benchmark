    elif lang == 'fortran':
        fil.write(Tm('function ${F}(x) result(r); integer(${T}), value :: x; integer(${T}) :: r; r = ${X}; end function\n').substitute(
            T=typ, F=str(fname), X=expr))
    elif lang == 'hare':
        fil.write(Tm('fn ${F}(x: ${T}) ${T} = { return ${X}; };\n').substitute(
            T=typ, F=str(fname), X=expr))
    elif lang == 'haskell':
        if templated:
            fil.write(Tm('${F} :: Num a => a -> a\n${F} x = ${X}\n').substitute(
                F=str(fname), X=expr))
        else:
            fil.write(Tm('${F} :: ${T} -> ${T}\n${F} x = ${X}\n').substitute(
                T=typ, F=str(fname), X=expr))
    elif lang == 'python' or lang == 'mojo':
        if templated:
            fil.write(Tm('def ${F}(x: ${T}) -> ${T}:\n    return ${X}\n\n').substitute(
                T='int', F=str(fname), X=expr))
        else:
            fil.write(Tm('def ${F}(x):\n    return ${X}\n\n').substitute(
                F=str(fname), X=expr))
    elif lang == 'scheme':
