RAND_POOL_SIZE = 4096
RAND_POOL_MASK = RAND_POOL_SIZE - 1
RAND_STR_POOL = [str(random.randint(0, 100000)) for _ in range(RAND_POOL_SIZE)]


def generate_function_definitions(spec: LangSupport, types: list[str], args: argparse.Namespace, sink, templated: bool):
    write = sink.write
    func_count = args.function_count
    func_depth = args.function_depth
    rand_pool = RAND_STR_POOL
    mask = RAND_POOL_MASK
    rand_idx = 0
    for typ in types:
        emitter = spec.func_emitter(typ, templated, func_depth)
        for findex in range(func_count):
            chunk = []
            for fheight in range(func_depth):
                nconst = rand_pool[rand_idx & mask] if RANDOMIZE_FLAG else str(findex)
                rand_idx += 1
                chunk.append(emitter(findex, fheight, nconst))
            chunk.append('\n')
            write(''.join(chunk))
        write('\n')


def generate_test_program_file(lang: str,
                               args: argparse.Namespace,
                               templated: bool,
                               run_ix,
                               *,
                               program_dir: Callable[[str, bool, int], str] = _default_program_dir,
                               source_filename: Callable[[str, bool, int, str], str] = _default_source_filename,
                               order_sections: Callable[[Callable[[], None], Callable[[], None]], None] = _defs_then_header):
    """Generate one synthetic program for `lang` and return its path.

    Per-language layout quirks are supplied as callables (taken from LangSupport by the caller):
      program_dir(base_dir, templated, run_ix)                -> directory the source is written to
      source_filename(program_name, templated, run_ix, ext)   -> source file name
      order_sections(write_header, write_defs)                -> calls the two thunks in the order
                                                                 the language requires
    """
    spec = lang_support(lang)
    program_name = DEFAULT_PROGRAM_NAME
    types = [spec.int_type]
    dir_path = program_dir(out_directory(lang), templated, run_ix)
    os.makedirs(dir_path, exist_ok=True)
    path = os.path.join(dir_path, source_filename(program_name, templated, run_ix, spec.extension))

    start = timer()
    buf = io.StringIO()
    buf.write(spec.prefix(program_name, templated))

    order_sections(
        lambda: buf.write(spec.main_header(types, templated)),
        lambda: generate_function_definitions(spec, types, args, buf, templated),
    )

    for typ in types:
        buf.write(spec.var_decl(typ, templated))

    buf.write(spec.main_middle(types))

    for typ in types:
        for findex in range(args.function_count):
            buf.write(spec.call(findex, typ, templated) + spec.call_terminator + '\n')

    buf.write(spec.postfix(types))

    with open(path, 'w') as sink:
        sink.write(buf.getvalue())
    dur = timer() - start
    if getattr(args, 'verbose', False):
        print('- Generating {} took {:1.3f} seconds ({})'.format(path, dur, lang))

    return path


