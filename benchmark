def get_semantic_tier(lang: str, cexe: str) -> int:
    spec = lang_support(lang)
    base = os.path.basename(cexe).lower()
    for prefix, tier in spec.exe_tiers.items():
        if base.startswith(prefix):
            return tier
    return spec.tier


def render_single_table(titles: list[str], results: Results, values_mode: str = "absolute", highlight: bool = False) -> str:
    res_copy = {k: list(v) for k, v in results.items()}
    format_metric_columns(results=res_copy, column_ix=AST_CHECK_DUR_PER_FUNC_IX, values_mode=values_mode, highlight=highlight)
    format_metric_columns(results=res_copy, column_ix=CHECK_DUR_PER_FUNC_IX, values_mode=values_mode, highlight=highlight)
    format_metric_columns(results=res_copy, column_ix=COMPILE_DUR_PER_FUNC_IX, values_mode=values_mode, highlight=highlight)
    format_metric_columns(results=res_copy, column_ix=BUILD_DUR_PER_FUNC_IX, values_mode=values_mode, highlight=highlight)
    format_metric_columns(results=res_copy, column_ix=RUN_DUR_PER_FUNC_IX, values_mode=values_mode, highlight=highlight)
    format_metric_columns(results=res_copy, column_ix=CHECK_RSS_MU_IX, values_mode=values_mode, highlight=highlight)
    format_metric_columns(results=res_copy, column_ix=BUILD_RSS_MU_IX, values_mode=values_mode, highlight=highlight)
    format_metric_columns(results=res_copy, column_ix=OUTPUT_SIZE_IX, values_mode=values_mode, highlight=highlight)

    merged_results = merge_plain_and_templated_results(res_copy)
    sorted_rows = sorted(merged_results.values(), key=lambda r: r[0].lower())

    def _visible_len(cell) -> int:
        return len(re.sub("<[^>]+>", "", str(cell)))

    def _pad(cell, width: int) -> str:
        cell = str(cell)
        return cell + " " * max(width - _visible_len(cell), 0)

    col_widths = [len(t) for t in titles]
    for row in sorted_rows:
        for idx, cell in enumerate(row):
            col_widths[idx] = max(col_widths[idx], _visible_len(cell))

    nl = chr(10)
    lines = []
    lines.append("| " + " | ".join(_pad(titles[i], col_widths[i]) for i in range(len(titles))) + " |")
    lines.append("| " + " | ".join(":" + "-" * (col_widths[i] - 2) + ":" for i in range(len(titles))) + " |")
    for row in sorted_rows:
        lines.append("| " + " | ".join(_pad(row[i], col_widths[i]) for i in range(len(row))) + " |")
    return nl.join(lines) + nl


def markdown_table(titles: list[str], results: Results, values_mode: str = "absolute", highlight: bool = False) -> str:
    tiered_results: dict[int, Results] = {1: {}, 2: {}, 3: {}}
    for key, row in results.items():
        lang, _, cexe = key
        tier = get_semantic_tier(str(lang), str(cexe))
        tiered_results[tier][key] = list(row)

    nl = chr(10)
    sections = []
    for tier_id, title, desc in TIERS:
        t_res = tiered_results.get(tier_id)
        if not t_res:
            continue
        tbl = render_single_table(titles, t_res, values_mode=values_mode, highlight=highlight)
        sections.append("### " + title + nl + "*" + desc + "*" + nl + nl + tbl)

    return (nl + nl).join(sections)


