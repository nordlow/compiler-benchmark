def bm_CSharp_using_mcs(results: Results, code_paths, args: argparse.Namespace, op, templated: bool):
    lang = 'C#'
    cexe = match_lang_cexe(args, lang, 'mcs')
    if not cexe:
        return

    cexe_flags = ['-target:exe']

    check_temp_file = None
    if op == 'check':
        check_temp_file = out_binary(lang) + ".check_tmp"
        out_flag = ['-out:' + check_temp_file]
    else:
        out_flag = ['-out:' + out_binary(lang)]

    try:
        version_output = sp.run([cexe, '--version'], stdout=sp.PIPE, stderr=sp.STDOUT).stdout.decode('utf-8')
        version = version_output.split()[4]
    except (IndexError, sp.CalledProcessError, Exception):
        version = "unknown"

    try:
        compile_file(code_paths,
                     out_flag_and_exe=out_flag,
                     cexe=cexe,
                     runner=True,
                     cexe_flags=cexe_flags,
                     args=args,
                     op=op,
                     compiler_version=version,
                     lang=lang,
                     templated=templated,
                     results=results)
    finally:
        if check_temp_file and os.path.exists(check_temp_file):
            try:
                os.remove(check_temp_file)
            except OSError:
                pass


