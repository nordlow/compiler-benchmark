def format_metric_columns(results: Results, column_ix: int, values_mode: str = 'absolute', highlight: bool = False):
    # Track the smallest value per column separately for the plain (P) and
    # templated (T) variant of each language, so each half of a merged
    # "P / T" cell gets its own winner highlighted independently.
    min_vals = {False: None, True: None}
    for key, result in results.items():
        templated = key[1]
        if isinstance(result[column_ix], (int, float)):
            if min_vals[templated] is None or (min_vals[templated] > result[column_ix]):
                min_vals[templated] = result[column_ix]

    for key, result in results.items():
        templated = key[1]
        result[column_ix] = stringify_metrics(abs_n=result[column_ix],
                                              min_val=min_vals[templated],
                                              column_ix=column_ix,
                                              values_mode=values_mode,
                                              highlight=highlight)


def stringify_metrics(abs_n, min_val, column_ix, values_mode: str = 'absolute', highlight: bool = False):
    if isinstance(abs_n, str):
        return '{:>13}'.format(abs_n)
    if abs_n is None:
        return '{:>6}'.format('N/A')

    if column_ix in (AST_CHECK_DUR_PER_FUNC_IX, CHECK_DUR_PER_FUNC_IX, COMPILE_DUR_PER_FUNC_IX, BUILD_DUR_PER_FUNC_IX):
        abs_str = to_str_in_microseconds(abs_n)
    elif column_ix == RUN_DUR_PER_FUNC_IX:
        abs_str = to_str_in_nanoseconds(abs_n)
    elif column_ix in (CHECK_RSS_MU_IX, BUILD_RSS_MU_IX):
        abs_str = to_str_memory_usage(abs_n)
    elif column_ix == OUTPUT_SIZE_IX:
        abs_str = to_str_output_size(abs_n)
    else:
        abs_str = str(abs_n)

    is_min = min_val is not None and abs_n == min_val
    abs_str = abs_str.strip()

    # Highlight (color + bold) the smallest raw value in the column with a
    # badge so the winner stands out visually wherever the table is
    # rendered. Only applied when explicitly requested via `highlight`, and
    # then uniformly across every values_mode -- absolute, relative, and
    # both -- rather than only the absolute value.
    def _hl(text: str) -> str:
        return (
            f'<span style="color:#0a7f2e;background-color:#e6f7ec;font-weight:bold">{text}</span>'
            if highlight and is_min else text
        )

    if is_min:
        rel_str = " 1.0"
        rel_only = " 1.0"
    else:
        rel_n = abs_n / min_val
        rel_str = " (" + factor_str(rel_n) + ")"
        rel_only = factor_str(rel_n)

    if values_mode == 'relative':
        return _hl(rel_only)
    elif values_mode == 'both':
        return _hl(abs_str) + rel_str
    else:
        return _hl(abs_str)


def to_str_in_microseconds(dur):
    return '{:6.1f}'.format(1e6 * dur)


def to_str_in_nanoseconds(dur):
    return '{:6.0f}'.format(1e9 * dur) if dur is not None else ''


def factor_str(factor):
    return '{:.1f}'.format(factor)


def to_str_memory_usage(mu):
    return '{:6.1f}'.format(mu / 1e3)


def to_str_output_size(size):
    return '{:6.1f}'.format(size)


def markdown_header(text: str, nr: int):
    return '#' * nr + ' ' + text


def merge_plain_and_templated_results(results: Results):
    metric_cols = [
        CHECK_DUR_PER_FUNC_IX,
        COMPILE_DUR_PER_FUNC_IX,
        BUILD_DUR_PER_FUNC_IX,
        RUN_DUR_PER_FUNC_IX,
        CHECK_RSS_MU_IX,
        BUILD_RSS_MU_IX,
        OUTPUT_SIZE_IX,
    ]
    merged = {}
    grouped = {}
    for (lang, templated, cexe), row in results.items():
        grouped.setdefault((lang, cexe), {})[templated] = row

    for (lang, cexe), variants in grouped.items():
        row_plain = variants.get(False)
        row_tmpl = variants.get(True)
        base_row = row_plain if row_plain is not None else row_tmpl
        version = base_row[CEXE_VERSION_IX]
        version_str = f" {version}" if version and version != "unknown" else ""
        merged_row = [f"{base_row[LANG_IX]} ({base_row[CEXE_PATH_IX]}{version_str})"]
        has_ast_check = Op.AST_CHECK.value in lang_support(str(lang)).ops

        def format_col(col_ix):
            val_p = str(row_plain[col_ix]).strip() if row_plain and row_plain[col_ix] is not None else None
            val_t = str(row_tmpl[col_ix]).strip() if row_tmpl and row_tmpl[col_ix] is not None else None

            p_na = (val_p is None or val_p == 'N/A')
            t_na = (val_t is None or val_t == 'N/A')

            if p_na and t_na:
                return 'N/A'
            elif row_tmpl is None:  # Language has no templated variant benchmarked
                return f"{val_p},-" if not p_na else 'N/A'
            elif p_na:
                return f"-,{val_t}"
            elif t_na:
                return f"{val_p},-"
            else:
                return f"{val_p},{val_t}"

        for col in metric_cols:
            cell = format_col(col)
            if col == CHECK_DUR_PER_FUNC_IX and has_ast_check:
                ast_cell = format_col(AST_CHECK_DUR_PER_FUNC_IX)
                if ast_cell != 'N/A':
                    cell = f"{cell}<br>{ast_cell}"
            merged_row.append(cell)

        merged[(lang, cexe)] = merged_row

    return merged


