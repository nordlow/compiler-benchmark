RAND_POOL_SIZE = 4096
RAND_POOL_MASK = RAND_POOL_SIZE - 1
RAND_STR_POOL = [str(random.randint(0, 100000)) for _ in range(RAND_POOL_SIZE)]


def function_name(typ: str, findex: int, fheight: int | None = None) -> str:
    """Fast f-string based function name formatter (no string.Template overhead)."""
    if fheight is not None:
        return f"add_{typ}_n{findex}_h{fheight}"
    return f"add_{typ}_n{findex}"


def get_function_emitter(lang: str, typ: str, templated: bool, depth: int):
    """
    Returns a specialized closure (findex, fheight, nconst) -> str for the given language.
    Eliminates all language-based branch checks from inside the 40,000-iteration loop.
    """
    llang = lang.lower()

    # Pre-select definition templates and expression rules per language
    if llang == 'c':
        def emit(findex: int, fheight: int, nconst: str) -> str:
            if fheight == 0:
                expr = f"x + {nconst}"
            else:
                prev = function_name(typ, findex, fheight - 1)
                expr = f"x + {prev}(x) + {nconst}"
            fname = function_name(typ, findex, None if fheight == depth - 1 else fheight)
            return f"{typ} {fname}({typ} x) {{ return {expr}; }}\n"

    elif llang == 'c++':
        tmpl_prefix = 'template<typename T=int> ' if templated else ''
        def emit(findex: int, fheight: int, nconst: str) -> str:
            if fheight == 0:
                expr = f"x + {nconst}"
            else:
                prev = function_name(typ, findex, fheight - 1)
                expr = f"x + {prev}(x) + {nconst}"
            fname = function_name(typ, findex, None if fheight == depth - 1 else fheight)
            return f"{tmpl_prefix}{typ} {fname}({typ} x) {{ return {expr}; }}\n"

    elif llang == 'rust':
        if templated:
            def emit(findex: int, fheight: int, nconst: str) -> str:
                if fheight == 0:
                    expr = "x"
                else:
                    prev = function_name(typ, findex, fheight - 1)
                    expr = f"x + {prev}(x)"
                fname = function_name(typ, findex, None if fheight == depth - 1 else fheight)
                return f"fn {fname}<T: Copy + Add<Output = T>>(x: T) -> T {{ {expr} }}\n"
        else:
            def emit(findex: int, fheight: int, nconst: str) -> str:
                if fheight == 0:
                    expr = f"x + {nconst}"
                else:
                    prev = function_name(typ, findex, fheight - 1)
                    expr = f"x + {prev}(x) + {nconst}"
                fname = function_name(typ, findex, None if fheight == depth - 1 else fheight)
                return f"fn {fname}(x: {typ}) -> {typ} {{ {expr} }}\n"

    elif llang == 'zig':
        if templated:
            def emit(findex: int, fheight: int, nconst: str) -> str:
                if fheight == 0:
                    expr = f"x + {nconst}"
                else:
                    prev = function_name(typ, findex, fheight - 1)
                    expr = f"x + {prev}({typ}, x) + {nconst}"
                fname = function_name(typ, findex, None if fheight == depth - 1 else fheight)
                return f"fn {fname}(comptime T: type, x: T) T {{ return {expr}; }}\n"
        else:
            def emit(findex: int, fheight: int, nconst: str) -> str:
                if fheight == 0:
                    expr = f"x + {nconst}"
                else:
                    prev = function_name(typ, findex, fheight - 1)
                    expr = f"x + {prev}(x) + {nconst}"
                fname = function_name(typ, findex, None if fheight == depth - 1 else fheight)
                return f"fn {fname}(x: {typ}) {typ} {{ return {expr}; }}\n"

    elif llang == 'go':
        def emit(findex: int, fheight: int, nconst: str) -> str:
            if fheight == 0:
                expr = f"x + {nconst}"
            else:
                prev = function_name(typ, findex, fheight - 1)
                expr = f"x + {prev}(x) + {nconst}"
            fname = function_name(typ, findex, None if fheight == depth - 1 else fheight)
            return f"func {fname}(x {typ}) {typ} {{ return {expr} }}\n"

    # Generic fallback handling all other languages with fast f-strings
    else:
        def emit(findex: int, fheight: int, nconst: str) -> str:
            # Replicates the existing logic, but replacing all Tm(...) with f-strings
            if fheight == 0:
                if llang == 'ocaml':
                    expr = f"x +. {nconst}.0"
                elif llang in ('scheme', 'common lisp', 'guile'):
                    expr = f"(+ x {nconst})"
                elif llang == 'c3' and templated:
                    expr = f"x + (Type){nconst}"
                else:
                    expr = f"x + {nconst}"
            else:
                xtarg = f"{typ}, " if (llang == 'zig' and templated) else ''
                prev = function_name(typ, findex, fheight - 1)
                if llang == 'v' and templated:
                    expr = f"x + {prev}[{typ}](x) + {nconst}"
                elif llang == 'vox' and templated:
                    expr = f"x + {prev}[{typ}](x) + {nconst}"
                elif llang == 'ocaml':
                    expr = f"x +. ({prev}{xtarg} x) +. {nconst}.0"
                elif llang in ('swift', 'hylo'):
                    expr = f"x + {prev}(x: {xtarg}x) + {nconst}"
                elif llang == 'pareas':
                    expr = f"x + {prev}[x] + {nconst}"
                elif llang == 'mojo':
                    expr = f"x + {prev}(x) + {nconst}"
                elif llang == 'haskell':
                    expr = f"x + {prev} x + {nconst}"
                elif llang in ('scheme', 'common lisp', 'guile'):
                    expr = f"(+ x ({prev} x) {nconst})"
                else:
                    expr = f"x + {prev}({xtarg}x) + {nconst}"

            fname = function_name(typ, findex, None if fheight == depth - 1 else fheight)

            if llang == 'lua':
                return f"function {fname}(x) return {expr} end\n"
            elif llang == 'c3':
                if templated:
                    return f"fn Type {fname}(Type x) <Type> {{ return {expr}; }}\n"
                return f"fn {typ} {fname}({typ} x) {{ return {expr}; }}\n"
            elif llang == 'ada':
                return f"   function {fname} (x: {typ}) return {typ} is ({expr});\n"
            elif llang == 'c#':
                return f"    static {typ} {fname}({typ} x) {{ return {expr}; }}\n"
            elif llang == 'java':
                return f"    static {typ} {fname}({typ} x) {{ return {expr}; }}\n"
            elif llang in ('d', 'vox'):
                t_str = 'T' if templated else typ
                m_str = ('(T)' if llang == 'd' else '[T]') if templated else ''
                q_str = ' @safe pure nothrow @nogc' if llang == 'd' else ''
                return f"{t_str} {fname}{m_str}({t_str} x){q_str} {{ return {expr}; }}\n"
            elif llang in ('swift', 'hylo'):
                if templated:
                    return f"func {fname}<T: BinaryInteger>(x: T) -> T {{ return {expr} }}\n"
                return f"func {fname}(x: {typ}) -> {typ} {{ return {expr} }}\n"
            elif llang == 'nim':
                if templated:
                    return f"proc {fname}[T](x: T): T =\n  return {expr}\n"
                return f"proc {fname}(x: {typ}): {typ} = \n  return {expr}\n"
            elif llang == 'ocaml':
                return f"let {fname} x = {expr}\n"
            elif llang == 'v':
                if templated:
                    return f"fn {fname}[T](x T) T {{ return {expr} }}\n"
                return f"fn {fname}(x {typ}) {typ} {{ return {expr} }}\n"
            elif llang == 'julia':
                qt = '' if templated else f"::{typ}"
                return f"function {fname}(x{qt}){qt}\n    return {expr}\nend;\n"
            elif llang == 'pareas':
                return f"fn {fname}[x: {typ}]: {typ} {{ return {expr}; }}\n"
            elif llang == 'mojo':
                return f"fn {fname}(x: {typ}) -> {typ}: return {expr}\n"
            elif llang == 'odin':
                if templated:
                    return f"{fname} :: proc(x: $T) -> T {{ return {expr} }}\n"
                return f"{fname} :: proc(x: {typ}) -> {typ} {{ return {expr} }}\n"
            elif llang == 'crystal':
                if templated:
                    return f"def {fname}(x); return {expr}; end\n"
                return f"def {fname}(x : {typ}) : {typ}; return {expr}; end\n"
            elif llang == 'pascal':
                return f"function {fname}(x: {typ}): {typ}; begin {fname} := {expr}; end;\n"
            elif llang == 'fortran':
                return f"function {fname}(x) result(r); integer({typ}), value :: x; integer({typ}) :: r; r = {expr}; end function\n"
            elif llang == 'hare':
                return f"fn {fname}(x: {typ}) {typ} = {{ return {expr}; }};\n"
            elif llang == 'haskell':
                if templated:
                    return f"{fname} :: Num a => a -> a\n{fname} x = {expr}\n"
                return f"{fname} :: {typ} -> {typ}\n{fname} x = {expr}\n"
            elif llang in ('python', 'mojo'):
                if templated:
                    return f"def {fname}(x: int) -> int:\n    return {expr}\n\n"
                return f"def {fname}(x):\n    return {expr}\n\n"
            elif llang in ('scheme', 'guile'):
                return f"(define ({fname} x) {expr})\n"
            elif llang == 'pony':
                return f"  fun {fname}(x: {typ}): {typ} => {expr}\n"
            elif llang == 'typescript':
                if templated:
                    return f"function {fname}<T extends {typ}>(x: T): {typ} {{ return {expr}; }}\n"
                return f"function {fname}(x: {typ}): {typ} {{ return {expr}; }}\n"
            elif llang == 'dart':
                if templated:
                    return f"{typ} {fname}<T extends {typ}>(T x) {{ return {expr}; }}\n"
                return f"{typ} {fname}({typ} x) {{ return {expr}; }}\n"
            elif llang == 'common lisp':
                return f"(defun {fname} (x) {expr})\n"
            return ""

    return emit


def generate_main_test_function_definition_set(lang: str, types: list[str], args: argparse.Namespace, sink, templated: bool):
    write = sink.write
    func_count = args.function_count
    func_depth = args.function_depth
    rand_pool = RAND_STR_POOL
    mask = RAND_POOL_MASK
    rand_idx = 0
    for typ in types:
        emitter = get_function_emitter(lang, typ, templated, func_depth)
        for findex in range(func_count):
            chunk = []
            for fheight in range(func_depth):
                nconst = rand_pool[rand_idx & mask] if RANDOMIZE_FLAG else str(findex)
                rand_idx += 1
                chunk.append(emitter(findex, fheight, nconst))
            chunk.append('\n')
            write(''.join(chunk))
        write('\n')




