    Lang("lua"): LangSpec(FileExt("lua"), TypeName("int")),
    Lang("pony"): LangSpec(FileExt("pony"), TypeName("I64")),
    Lang("typescript"): LangSpec(FileExt("ts"), TypeName("number")),
    Lang("dart"): LangSpec(FileExt("dart"), TypeName("int")),
    Lang("common lisp"): LangSpec(FileExt("lisp"), TypeName("int")),
