def compile_file(code_paths: list,
                 out_flag_and_exe,
                 cexe: str,
                 runner,
                 cexe_flags: list[str],
                 args: argparse.Namespace,
                 op: str,
                 compiler_version=None,
                 lang=None,
                 templated: bool = False,
                 results: dict[tuple, list] = {},
                 stdin_input: str|None = None):
    key: tuple = (lang, templated, cexe)

    lang_dir = out_directory(lang)
    abs_lang_dir = os.path.abspath(lang_dir)

    if key not in results:
        row = [None] * MARKDOWN_TABLE_LENGTH
        results[key] = row
    else:
        row = results[key]

    durs = []
    rss_mu = None
    for run_ix in range(0, args.run_count):
        src_key = sourceIdOf(lang, templated, run_ix)

        if src_key in code_paths:
            src_path = code_paths[src_key]
        else:
            src_path = generate_test_program_file(lang, args, templated, run_ix)
            code_paths[src_key] = src_path
        src_name = os.path.basename(src_path)

        cstart = timer()
        if stdin_input:
            p_args = [cexe] + cexe_flags + out_flag_and_exe
        else:
            if lang == 'Odin':
                if cexe_flags and cexe_flags[0] in ['build', 'check']:
                    cmd = [cexe_flags[0]]
                    remaining_flags = cexe_flags[1:]
                    p_args = [cexe] + cmd + [src_name, '-file'] + remaining_flags + out_flag_and_exe
                else:
                    p_args = [cexe] + cexe_flags + [src_name, '-file'] + out_flag_and_exe
            else:
                p_args = [cexe] + cexe_flags + out_flag_and_exe + [src_name]
        cwd = os.getcwd()
        os.chdir(lang_dir)
        from process_timer import ProcessTimer

        if stdin_input:
            formatted_stdin = stdin_input.format(run_ix)
            import subprocess as sp
            comp_proc = sp.Popen(p_args, stdin=sp.PIPE, stdout=sp.PIPE, stderr=sp.PIPE)
            outs, errs = comp_proc.communicate(input=formatted_stdin.encode('utf-8'))
            rss_mu = "unavailable"
            pt = type('obj', (object,), {'comp_proc': comp_proc})()
        else:
            pt = ProcessTimer(args=p_args)
            try:
                while pt.poll():
                    time.sleep(1.0 / args.sample_rate)
            except Exception:
                rss_mu = "sampling error"
            finally:
                if rss_mu is None and pt.max_rss_mu != 0:
                    rss_mu = pt.max_rss_mu
                if rss_mu is None:
                    rss_mu = "missing"

            outs, errs = pt.comp_proc.communicate()
        os.chdir(cwd)

        if pt.comp_proc.returncode != 0 and op != 'run':
            print("WARNING: Compilation `" + ' '.join([cexe] + cexe_flags) +
                  "` of source file `" + src_name +
                  "` exited with return code " + str(pt.comp_proc.returncode) +
                  ("`\n  - stdout:\n" + str(outs) if outs else "") +
                  ("`\n  - stderr:\n" + errs.decode('utf8') if errs else ""),
                  file=sys.stderr)
            if rss_mu and isinstance(rss_mu, (int, float)):
                if op == 'check':
                    row[CHECK_RSS_MU_IX] = rss_mu / (args.function_count * args.function_depth)
                if op == 'build':
                    row[BUILD_RSS_MU_IX] = rss_mu / (args.function_count * args.function_depth)
            return None

        durs.append(timer() - cstart)

    dur_min = min(durs)
    run_dur_min = None
    if op == 'run':
        if runner:
            run_args = runner + [src_name] if isinstance(runner, list) else [src_name]
            run_dur_min = run_compiled_file(run_args, run_count=args.run_count)
    elif op == 'build':
        outb = out_binary(lang)
        if runner and lang != 'Python':
            if runner is True:
                if (cexe.endswith('cproc')):
                    outb_path = os.path.join(abs_lang_dir, outb)
                    st = os.stat(outb_path)
                    os.chmod(outb_path, st.st_mode | stat.S_IEXEC)
                run_dur_min = run_compiled_file(os.path.join(lang_dir, outb))
            elif isinstance(runner, list):
                run_dur_min = run_compiled_file(runner + [outb])
        elif out_flag_and_exe:
            if runner is not False:
                print("TODO run " + outb + " using runner " + str(runner))

    compiler_version_str = ' version ' + str(compiler_version) if compiler_version is not None else ''
    cop = op.capitalize()
    print('- {} took {:1.3f} seconds (using "{}"{})'.
          format(cop, dur_min, cexe, compiler_version_str))

    return table_row(row=row,
                     args=args,
                     lang=lang,
                     op=op,
                     cexe_path=cexe,
                     compiler_version=compiler_version,
                     ast_check_dur=dur_min if op == 'ast-check' else None,
                     check_dur=dur_min if op == 'check' else None,
                     compile_dur=dur_min if op == 'compile' else None,
                     build_dur=dur_min if op == 'build' else None,
                     run_dur=run_dur_min,
                     check_rss_mu=rss_mu if op == 'check' else None,
                     build_rss_mu=rss_mu if op == 'build' else None,
                     templated=templated)


def run_compiled_file(args: argparse.Namespace, run_count=1):
    durs = []
    for _ in range(0, run_count):
        cstart = timer()
        sp.run(args, stdout=sp.DEVNULL, stderr=sp.DEVNULL)
        durs.append(timer() - cstart)
    return min(durs) if durs else None


