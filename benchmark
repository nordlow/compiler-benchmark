def get_compiler_version(cexe: str, default: str = 'unknown') -> str:
    """Robustly extract version identifier across compiler toolchains."""
    base = os.path.basename(cexe)
    if base.startswith('cproc') or base.startswith('pareas'):
        return 'unknown'
    if base.startswith('cuik') or base.startswith('vox'):
        return '~master' if base.startswith('cuik') else 'master'

    if base.startswith(('odin', 'zig', 'hare', 'go')):
        cmd = [cexe, 'version']
    elif base.startswith('tcc'):
        cmd = [cexe, '-v']
    elif base.startswith('fpc'):
        cmd = [cexe, '-iV']
    elif base.startswith(('csc', 'javac')):
        cmd = [cexe, '-version']
    else:
        cmd = [cexe, '--version']

    try:
        res = sp.run(cmd, stdout=sp.PIPE, stderr=sp.PIPE)
        out = (res.stdout or res.stderr).decode('utf-8', errors='ignore').strip()
        if base.startswith('odin'):
            parts = out.split()
            return parts[2] if len(parts) >= 3 else default
        if base.startswith('go'):
            parts = out.split()
            if len(parts) >= 3 and parts[2].startswith('go'):
                return parts[2][2:].split('~')[0].split('ubuntu')[0]
        if base.startswith('c3c') and ':' in out:
            return out.split(':')[1].split()[0]
        if base.startswith('scheme'):
            return out
        for part in out.split():
            clean = part.strip(',;:()')
            if clean and (clean[0].isdigit() or (clean.startswith('v') and len(clean) > 1 and clean[1].isdigit())):
                return clean.split('~')[0].split('ubuntu')[0]
    except Exception:
        pass
    return default


